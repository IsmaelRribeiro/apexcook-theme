{% comment %}
  Section contract.
  Samsung-style before/after comparison: centred heading and text, full-width drag slider with labels
  over the images and a round ‹ › handle, then a large stat under each side.
  The slider is a native range input laid over the images, so it works with mouse, touch and keyboard.
  @example
  <!-- Product template; set both images, labels and stats -->
{% endcomment %}
{%- liquid
  assign pos = section.settings.start_position
-%}
<div class="apex-cmp{% if section.settings.full_width %} apex-cmp--bleed{% endif %}">
  {%- if section.settings.heading != blank or section.settings.text != blank -%}
    <div class="apex-cmp__intro">
      {%- if section.settings.heading != blank -%}<h2 class="apex-cmp__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="apex-cmp__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>
  {%- endif -%}

  <apex-compare class="apex-cmp__stage" style="--apex-cmp-pos: {{ pos }}%;">
    <div class="apex-cmp__side apex-cmp__side--right">
      {%- if section.settings.right_image -%}
        {{ section.settings.right_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1200, 1800, 2400', sizes: '100vw', alt: section.settings.right_label, class: 'apex-cmp__img' }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'apex-cmp__img apex-cmp__img--ph apex-cmp__img--ph-right' }}
      {%- endif -%}
      {%- if section.settings.right_label != blank -%}<p class="apex-cmp__label apex-cmp__label--right" aria-hidden="true">{{ section.settings.right_label | escape }}</p>{%- endif -%}
    </div>
    <div class="apex-cmp__side apex-cmp__side--left">
      {%- if section.settings.left_image -%}
        {{ section.settings.left_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1200, 1800, 2400', sizes: '100vw', alt: section.settings.left_label, class: 'apex-cmp__img' }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'apex-cmp__img apex-cmp__img--ph apex-cmp__img--ph-left' }}
      {%- endif -%}
      {%- if section.settings.left_label != blank -%}<p class="apex-cmp__label apex-cmp__label--left" aria-hidden="true">{{ section.settings.left_label | escape }}</p>{%- endif -%}
    </div>
    <span class="apex-cmp__line" aria-hidden="true">
      <span class="apex-cmp__handle">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m9 7-5 5 5 5M15 7l5 5-5 5"/></svg>
      </span>
    </span>
    <input
      class="apex-cmp__range"
      type="range"
      min="0"
      max="100"
      step="1"
      value="{{ pos }}"
      aria-label="{{ 'apex.compare.label' | t: left: section.settings.left_label, right: section.settings.right_label }}"
    >
  </apex-compare>

  {%- if section.settings.left_stat != blank or section.settings.right_stat != blank -%}
    <div class="apex-cmp__stats">
      <p class="apex-cmp__stat apex-cmp__stat--left" style="color: {{ section.settings.left_stat_color }};">
        {%- if section.settings.left_stat_prefix != blank -%}<span class="apex-cmp__stat-small">{{ section.settings.left_stat_prefix | escape }}</span> {% endif -%}
        <span class="apex-cmp__stat-big">{{ section.settings.left_stat | escape }}</span>
        {%- if section.settings.left_stat_suffix != blank %} <span class="apex-cmp__stat-small">{{ section.settings.left_stat_suffix | escape }}</span>{%- endif -%}
      </p>
      <p class="apex-cmp__stat apex-cmp__stat--right" style="color: {{ section.settings.right_stat_color }};">
        {%- if section.settings.right_stat_prefix != blank -%}<span class="apex-cmp__stat-small">{{ section.settings.right_stat_prefix | escape }}</span> {% endif -%}
        <span class="apex-cmp__stat-big">{{ section.settings.right_stat | escape }}</span>
        {%- if section.settings.right_stat_suffix != blank %} <span class="apex-cmp__stat-small">{{ section.settings.right_stat_suffix | escape }}</span>{%- endif -%}
      </p>
    </div>
  {%- endif -%}
</div>

{% javascript %}
  if (!customElements.get('apex-compare')) {
    customElements.define(
      'apex-compare',
      class extends HTMLElement {
        connectedCallback() {
          const range = this.querySelector('.apex-cmp__range');
          if (!range) return;
          const sync = () => this.style.setProperty('--apex-cmp-pos', `${range.value}%`);
          range.addEventListener('input', sync);
          sync();
        }
      }
    );
  }
{% endjavascript %}

{% stylesheet %}
  /* Measured from the Galaxy Watch Ultra2 page: centred 40px heading, 16px text, edge-to-edge stage,
     white 2px divider with a 56px round handle, ~32px labels on the images, large stats below. */
  .apex-cmp {
    padding-block: 64px;
    color: #000;
  }

  .apex-cmp__intro {
    max-width: 940px;
    margin: 0 auto 40px;
    padding-inline: 24px;
    text-align: center;
  }

  .apex-cmp__heading {
    margin: 0 0 16px;
  }

  .apex-cmp__text {
    font-size: 16px;
    line-height: 1.4;
    color: #313131;
  }

  .apex-cmp__text p {
    margin: 0;
  }

  .apex-cmp__stage {
    position: relative;
    display: block;
    max-width: var(--page-width, 1440px);
    margin-inline: auto;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #e9e9e9;
    touch-action: pan-y;
  }

  .apex-cmp--bleed .apex-cmp__stage {
    max-width: none;
  }

  @media screen and (min-width: 990px) {
    .apex-cmp__stage {
      aspect-ratio: 1440 / 1000;
    }
  }

  .apex-cmp__side {
    position: absolute;
    inset: 0;
  }

  .apex-cmp__side--left {
    clip-path: inset(0 calc(100% - var(--apex-cmp-pos)) 0 0);
  }

  .apex-cmp__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apex-cmp__img--ph-left {
    background: #d9d9d9;
    fill: #bdbdbd;
  }

  .apex-cmp__img--ph-right {
    background: #c9d6c4;
    fill: #a9b8a3;
  }

  .apex-cmp__label {
    position: absolute;
    bottom: 6%;
    margin: 0;
    color: #fff;
    font-size: clamp(16px, 2.6vw, 38px);
    font-weight: 600;
    line-height: 1.2;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.25);
  }

  .apex-cmp__label--left {
    left: 16px;
  }

  .apex-cmp__label--right {
    right: 16px;
    text-align: end;
  }

  @media screen and (min-width: 990px) {
    .apex-cmp__label--left {
      left: 24px;
    }

    .apex-cmp__label--right {
      right: 24px;
    }
  }

  .apex-cmp__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--apex-cmp-pos);
    width: 3px;
    background: #fff;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .apex-cmp__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    color: #000;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.2);
    transform: translate(-50%, -50%);
  }

  .apex-cmp__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    appearance: none;
  }

  .apex-cmp__stage:has(.apex-cmp__range:focus-visible) .apex-cmp__handle {
    outline: 2px solid #2189ff;
    outline-offset: 2px;
  }

  .apex-cmp__stats {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    max-width: var(--page-width, 1440px);
    margin: 28px auto 0;
    padding-inline: 16px;
  }

  .apex-cmp--bleed .apex-cmp__stats {
    max-width: none;
  }

  @media screen and (min-width: 990px) {
    .apex-cmp__stats {
      padding-inline: 24px;
    }
  }

  .apex-cmp__stat {
    margin: 0;
    font-weight: 600;
    line-height: 1.1;
  }

  .apex-cmp__stat--right {
    text-align: end;
  }

  .apex-cmp__stat-small {
    font-size: clamp(18px, 2.4vw, 34px);
  }

  .apex-cmp__stat-big {
    font-size: clamp(30px, 4.4vw, 64px);
    letter-spacing: -0.01em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook compare slider",
  "tag": "section",
  "class": "apex-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nothing to chip, peel or flake" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "range", "id": "start_position", "label": "Start position", "min": 10, "max": 90, "step": 5, "unit": "%", "default": 50 },
    { "type": "header", "content": "Left side" },
    { "type": "image_picker", "id": "left_image", "label": "Image" },
    { "type": "text", "id": "left_label", "label": "Label on image", "default": "Non-stick coating" },
    { "type": "text", "id": "left_stat_prefix", "label": "Stat – small text before" },
    { "type": "text", "id": "left_stat", "label": "Stat – large text", "default": "Toxic" },
    { "type": "text", "id": "left_stat_suffix", "label": "Stat – small text after" },
    { "type": "color", "id": "left_stat_color", "label": "Stat colour", "default": "#9a9a9a" },
    { "type": "header", "content": "Right side" },
    { "type": "image_picker", "id": "right_image", "label": "Image" },
    { "type": "text", "id": "right_label", "label": "Label on image", "default": "Pure titanium" },
    { "type": "text", "id": "right_stat_prefix", "label": "Stat – small text before" },
    { "type": "text", "id": "right_stat", "label": "Stat – large text", "default": "Safe" },
    { "type": "text", "id": "right_stat_suffix", "label": "Stat – small text after" },
    { "type": "color", "id": "right_stat_color", "label": "Stat colour", "default": "#7f9c6e" },
    { "type": "paragraph", "content": "Only use claims your supplier's test reports back up." }
  ],
  "presets": [{ "name": "ApexCook compare slider" }]
}
{% endschema %}
