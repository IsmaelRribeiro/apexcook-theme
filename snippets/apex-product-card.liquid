{% doc %}
  Compact product card (image, title, price, Add / Choose size) for places outside product grids,
  such as "Cooked with" on recipes.

  @param {object} product - Product to show

  @example
  {% render 'apex-product-card', product: article.metafields.recipe.product.value %}
{% enddoc %}
<div class="apex-product-card">
  <a href="{{ product.url }}" class="apex-product-card__media">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 750px) 300px, 50vw' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </a>
  <a href="{{ product.url }}" class="apex-product-card__title">{{ product.title | escape }}</a>
  {% render 'apex-price-was', product: product, variant: product.selected_or_first_available_variant, compact: true %}
  {% render 'apex-card-cta-button', product: product %}
</div>

{% stylesheet %}
  .apex-product-card {
    display: grid;
    gap: 8px;
    max-width: 320px;
  }

  .apex-product-card__media img,
  .apex-product-card__media svg {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .apex-product-card__title {
    color: inherit;
    font-weight: 500;
    text-decoration: none;
  }
{% endstylesheet %}
