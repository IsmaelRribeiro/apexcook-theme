{% comment %}
  Section contract.
  Scroll story: the image stays pinned while text steps scroll past (desktop). On mobile the image
  sits above the steps. Used for "No Hidden Chemicals" and "PFAS-free".
  @example
  <!-- Product template; add one Step block per message -->
{% endcomment %}
{%- if section.settings.enable_animation -%}{% render 'apex-motion-styles' %}{%- endif -%}
<div class="apex-story section section--full-width" style="--apex-bg: {{ section.settings.background_color }}; --apex-fg: {{ section.settings.text_color }};">
  <div class="section section--page-width">
    <div class="apex-story__grid">
      <div class="apex-story__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400', sizes: '(min-width: 990px) 50vw, 100vw', class: 'apex-story__image' }}
        {%- else -%}
          {{ 'product-apparel-2' | placeholder_svg_tag: 'apex-story__image' }}
        {%- endif -%}
      </div>
      <div class="apex-story__steps">
        {%- for block in section.blocks -%}
          <div class="apex-story__step" {% if section.settings.enable_animation %}data-apex-reveal{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.eyebrow != blank -%}<p class="apex-story__eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
            <h3 class="apex-story__heading">{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="apex-story__text">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .apex-story {
    padding-block: 64px;
    background: var(--apex-bg);
    color: var(--apex-fg);
  }

  .apex-story__grid {
    display: grid;
    gap: 32px;
  }

  .apex-story__image {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .apex-story__steps {
    display: grid;
    gap: 48px;
  }

  .apex-story__eyebrow {
    margin: 0 0 8px;
    font-size: 0.75rem;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .apex-story__heading {
    margin: 0 0 12px;
    color: inherit;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.1;
  }

  .apex-story__text {
    max-width: 48ch;
    opacity: 0.85;
  }

  @media screen and (min-width: 990px) {
    .apex-story__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 64px;
    }

    .apex-story__media {
      position: sticky;
      top: 96px;
    }

    .apex-story__step {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 70vh;
    }

    .apex-story__steps {
      gap: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook scroll story",
  "tag": "section",
  "class": "apex-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Pinned image" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#222222" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable animation", "default": true }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "No hidden chemicals" },
        { "type": "richtext", "id": "text", "label": "Text", "info": "Claims must be backed by your supplier's test reports." }
      ]
    }
  ],
  "presets": [
    {
      "name": "ApexCook scroll story",
      "blocks": [
        { "type": "step", "settings": { "eyebrow": "Titanium", "heading": "No hidden chemicals" } },
        { "type": "step", "settings": { "heading": "PFAS-free. Truly." } }
      ]
    }
  ]
}
{% endschema %}
