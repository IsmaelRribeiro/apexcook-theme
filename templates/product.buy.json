            "link": "/policies/shipping-policy"
          }
        },
        "b2": {
          "type": "benefit",
          "settings": {
            "icon_name": "returns",
            "title": "30-day returns",
            "text": "Changed your mind? Send it back within 30 days.",
            "link_label": "Learn more",
            "link": "/policies/refund-policy"
          }
        },
        "b3": {
          "type": "benefit",
          "settings": {
            "icon_name": "guarantee",
            "title": "10-year guarantee",
            "text": "Built to last, backed for a decade.",
            "link_label": "Learn more",
            "link": ""
          }
        },
        "b4": {
          "type": "benefit",
          "settings": {
            "icon_name": "secure",
            "title": "Secure checkout",
            "text": "Apple Pay, Google Pay, Shop Pay and cards.",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4"
      ],
      "settings": {
        "alignment": "center",
        "heading": "Join ApexCook. Enjoy the benefits",
        "enable_animation": true
      }
    },
    "apex_buy_info": {
      "type": "apex-buy-info",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How much is delivery?",
            "answer": "<p>UK delivery is free on orders over £50. Costs and times for your address are shown at checkout. See our <a href=\"/policies/shipping-policy\">shipping policy</a>.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I return an item?",
            "answer": "<p>Yes, you can return items within 30 days. See our <a href=\"/policies/refund-policy\">refund policy</a> for how it works.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "How can I pay?",
            "answer": "<p>All payment options available for your order are shown at checkout.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How do I contact you?",
            "answer": "<p>Send us a message through our <a href=\"/pages/contact\">contact page</a> and we will get back to you.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
      ],
      "settings": {
        "features_heading": "Key features",
        "show_compare": true,
        "compare_heading": "Compare the options",
        "faq_heading": "FAQ"
      }
    }
