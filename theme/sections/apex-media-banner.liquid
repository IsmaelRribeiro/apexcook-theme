{% comment %}
  Section contract.
  Full-width media band: muted looping video on desktop, still image on mobile, optional heading and button.
  @example
  <!-- Add "ApexCook media banner"; upload a video and a mobile image -->
{% endcomment %}
{%- if section.settings.enable_animation -%}{% render 'apex-motion-styles' %}{%- endif -%}
<div
  class="apex-media-banner section section--full-width"
  style="--apex-banner-bg: {{ section.settings.background_color }}; --apex-banner-fg: {{ section.settings.text_color }}; --apex-banner-min: {{ section.settings.min_height }}px;"
>
  <div class="apex-media-banner__inner">
    {%- if section.settings.video != blank -%}
      <div class="apex-media-banner__video">
        {{
          section.settings.video
          | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'none'
        }}
      </div>
    {%- endif -%}
    {%- if section.settings.mobile_image != blank -%}
      {{
        section.settings.mobile_image
        | image_url: width: 1200
        | image_tag:
          loading: 'lazy',
          widths: '450, 750, 1200',
          sizes: '100vw',
          class: 'apex-media-banner__image'
      }}
    {%- endif -%}
    {%- if section.settings.heading != blank or section.settings.button_label != blank -%}
      <div class="apex-media-banner__content" {% if section.settings.enable_animation %}data-apex-reveal{% endif %}>
        {%- if section.settings.heading != blank -%}
          <h2 class="apex-media-banner__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="apex-media-banner__button" href="{{ section.settings.button_link }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .apex-media-banner__inner {
    position: relative;
    display: grid;
    place-items: center;
    min-height: var(--apex-banner-min);
    overflow: hidden;
    background: var(--apex-banner-bg);
    color: var(--apex-banner-fg);
  }

  .apex-media-banner__video,
  .apex-media-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .apex-media-banner__video video,
  .apex-media-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apex-media-banner__video {
    display: none;
  }

  .apex-media-banner__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 32px 24px;
    text-align: center;
  }

  .apex-media-banner__heading {
    margin: 0;
    color: inherit;
  }

  .apex-media-banner__button {
    padding: 12px 20px;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    font-weight: 600;
    text-decoration: none;
  }

  @media screen and (min-width: 750px) {
    .apex-media-banner__video {
      display: block;
    }

    .apex-media-banner__video ~ .apex-media-banner__image {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook media banner",
  "tag": "section",
  "class": "apex-section",
  "settings": [
    { "type": "video", "id": "video", "label": "Desktop video", "info": "Plays muted on a loop." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Shown instead of the video on small screens." },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 240, "max": 800, "step": 20, "unit": "px", "default": 480 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#222222" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable animation", "default": true }
  ],
  "presets": [{ "name": "ApexCook media banner" }]
}
{% endschema %}
