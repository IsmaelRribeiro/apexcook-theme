{% comment %}
  Section contract.
  Samsung-style sticky product bar. Left: product name, star rating and the Features · Specs ·
  Reviews · Support tabs. Right: price, previous price / saving and "Buy now", which scrolls to
  the buy box.
  @example
  <!-- Product template, above the main product section -->
{% endcomment %}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  capture summary
    render 'apex-reviews-collect', product: product, mode: 'summary'
  endcapture
  assign parts = summary | strip | split: '|'
  assign count = parts[0] | plus: 0
  assign sum = parts[1] | plus: 0
-%}
<nav class="apex-anchor-nav" aria-label="{{ 'apex.nav.label' | t }}">
  <div class="section section--page-width">
    <div class="apex-anchor-nav__grid">
      <div class="apex-anchor-nav__info">
        <p class="apex-anchor-nav__title">{{ product.title | escape }}</p>
        {%- if count > 0 -%}
          {%- assign average = sum | times: 10.0 | divided_by: count | round | divided_by: 10.0 -%}
          <a class="apex-anchor-nav__rating" href="#reviews">
            {% render 'apex-stars', rating: average %}
            <span>{{ average }} ({{ count }})</span>
          </a>
        {%- endif -%}
      </div>
      <div class="apex-anchor-nav__buy">
        <div class="apex-anchor-nav__price">
          <strong>{{ variant.price | money }}</strong>
          {%- if variant.compare_at_price > variant.price -%}
            <span>
              <s>{{ variant.compare_at_price | money }}</s>
              {{ 'apex.buy_box.save' | t: amount: variant.compare_at_price | minus: variant.price | money }}
            </span>
          {%- endif -%}
        </div>
        <a class="apex-anchor-nav__cta" href="#buy">{{ 'apex.nav.buy' | t }}</a>
      </div>
      <ul class="apex-anchor-nav__links" role="list">
        <li><a href="#features">{{ 'apex.nav.features' | t }}</a></li>
        <li><a href="#specs">{{ 'apex.nav.specs' | t }}</a></li>
        <li><a href="#reviews">{{ 'apex.nav.reviews' | t }}</a></li>
        <li><a href="#support">{{ 'apex.nav.support' | t }}</a></li>
      </ul>
    </div>
  </div>
</nav>

{% stylesheet %}
  .apex-anchor-nav {
    position: sticky;
    top: 0;
    z-index: 4;
    background: var(--color-background);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .apex-anchor-nav__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'info buy' 'links links';
    align-items: center;
    gap: 4px 24px;
    padding-block: 10px 0;
  }

  .apex-anchor-nav__info {
    grid-area: info;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    min-width: 0;
  }

  .apex-anchor-nav__title {
    margin: 0;
    overflow: hidden;
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .apex-anchor-nav__rating {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    font-size: 0.75rem;
    text-decoration: none;
  }

  .apex-anchor-nav__buy {
    grid-area: buy;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .apex-anchor-nav__price {
    display: none;
    text-align: end;
    line-height: 1.2;
  }

  .apex-anchor-nav__price strong {
    display: block;
    font-size: 1.125rem;
  }

  .apex-anchor-nav__price span {
    font-size: 0.75rem;
    color: var(--color-primary-button-background);
  }

  .apex-anchor-nav__price s {
    margin-inline-end: 4px;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .apex-anchor-nav__cta {
    padding: 10px 20px;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .apex-anchor-nav__links {
    grid-area: links;
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 8px 0 10px;
    overflow-x: auto;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 600;
    scrollbar-width: none;
  }

  .apex-anchor-nav__links a {
    color: inherit;
    white-space: nowrap;
    text-decoration: none;
  }

  .apex-anchor-nav__links a:hover {
    text-decoration: underline;
  }

  @media screen and (min-width: 750px) {
    .apex-anchor-nav__price {
      display: block;
    }

    .apex-anchor-nav__title {
      font-size: 1.25rem;
    }
  }

  html {
    scroll-padding-top: 120px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook product nav",
  "tag": "section",
  "class": "apex-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [],
  "presets": [{ "name": "ApexCook product nav" }]
}
{% endschema %}
