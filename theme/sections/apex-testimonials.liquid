{% comment %}
  Section contract.
  Product page opener ("Features") plus customer testimonials from the apex_testimonial metaobjects.
  Each card shows where the testimonial came from.
  @example
  <!-- Product template; set Anchor to "features" -->
{% endcomment %}
{%- if section.settings.enable_animation -%}{% render 'apex-motion-styles' %}{%- endif -%}
<script src="{{ 'apex-carousel.js' | asset_url }}" type="module" fetchpriority="low"></script>
<div
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}
  class="apex-testimonials section section--full-width"
  style="--apex-bg: {{ section.settings.background_color }}; --apex-fg: {{ section.settings.text_color }};"
>
  {%- if section.settings.section_title != blank -%}
    <div class="section section--page-width apex-testimonials__opener">
      <h2 class="apex-testimonials__opener-title">{{ section.settings.section_title | escape }}</h2>
    </div>
  {%- endif -%}
  <div class="apex-testimonials__band">
    <div class="section section--page-width">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="apex-testimonials__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h3 class="apex-testimonials__heading">{{ section.settings.heading | escape }}</h3>{%- endif -%}
        <apex-carousel class="apex-testimonials__carousel">
          <ul class="apex-testimonials__list" role="list" data-track tabindex="0" aria-label="{{ section.settings.heading | escape }}">
            {%- for t in shop.metaobjects.apex_testimonial.values limit: section.settings.limit -%}
              {%- assign media = t.media.value -%}
              <li class="apex-testimonials__card">
                <div class="apex-testimonials__frame">
                  {%- if media.media_type == 'video' -%}
                    {{ media | video_tag: playsinline: true, preload: 'metadata', class: 'apex-testimonials__media', image_size: '720x' }}
                    <button type="button" class="apex-testimonials__play" data-apex-play>
                      <span class="visually-hidden">{{ 'apex.testimonials.play' | t: name: t.author.value }}</span>
                      {{ 'ph-play-fill.svg' | inline_asset_content | replace: '<svg ', '<svg width="28" height="28" ' }}
                    </button>
                  {%- elsif media != blank -%}
                    {{ media | image_url: width: 720 | image_tag: loading: 'lazy', class: 'apex-testimonials__media', alt: '' }}
                  {%- else -%}
                    <span class="apex-testimonials__media apex-testimonials__media--empty" aria-hidden="true">
                      {{ 'ph-video-camera.svg' | inline_asset_content | replace: '<svg ', '<svg width="40" height="40" ' }}
                    </span>
                  {%- endif -%}
                </div>
                <blockquote class="apex-testimonials__quote">{{ t.quote.value | escape | newline_to_br }}</blockquote>
                <p class="apex-testimonials__author">{{ t.author.value | escape }}{% if t.source.value != blank %} · <span>{{ t.source.value | escape }}</span>{% endif %}</p>
              </li>
            {%- endfor -%}
          </ul>
          <div class="apex-pcarousel__controls apex-testimonials__controls">
            <button type="button" class="apex-pantry__arrow apex-testimonials__arrow" data-prev aria-label="{{ 'apex.reviews.previous' | t }}">{%- render 'apex-mnav-icon', icon: 'left' -%}</button>
            <div class="apex-pcarousel__progress" aria-hidden="true"><span data-progress></span></div>
            <button type="button" class="apex-pantry__arrow apex-testimonials__arrow" data-next aria-label="{{ 'apex.reviews.next' | t }}">{%- render 'apex-mnav-icon', icon: 'right' -%}</button>
          </div>
        </apex-carousel>
      </div>
    </div>
  </div>
</div>

{% javascript %}
  document.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest('[data-apex-play]') : null;
    if (!button) return;
    const frame = button.closest('.apex-testimonials__frame');
    const video = frame?.querySelector('video');
    if (!frame || !video) return;
    document.querySelectorAll('.apex-testimonials__frame.is-playing video').forEach((other) => {
      if (other !== video) other.pause();
    });
    video.controls = true;
    frame.classList.add('is-playing');
    video.play();
  });
{% endjavascript %}

{% stylesheet %}
  .apex-testimonials__opener {
    padding-block: var(--apex-space) 24px;
  }

  .apex-testimonials__opener-title {
    margin: 0;
  }

  .apex-testimonials__band {
    padding-block: var(--apex-space);
    background: var(--apex-bg);
    color: var(--apex-fg);
  }

  .apex-testimonials__eyebrow {
    margin: 0 0 8px;
    font-size: 0.75rem;
    text-align: center;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .apex-testimonials__heading {
    margin: 0 0 32px;
    color: inherit;
    text-align: center;
  }

  /* Four portrait video cards per view on desktop, 2.2 on tablet, 1.25 on phones. */
  .apex-testimonials__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: 16px;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .apex-testimonials__list::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .apex-testimonials__list {
      grid-auto-columns: calc((100% - 32px) / 2.2);
    }
  }

  @media screen and (min-width: 990px) {
    .apex-testimonials__list {
      grid-auto-columns: calc((100% - 48px) / 4);
    }
  }

  .apex-testimonials__card {
    scroll-snap-align: start;
  }

  .apex-testimonials__frame {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: #222222;
  }

  .apex-testimonials__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apex-testimonials__media--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(255 255 255 / 0.35);
  }

  .apex-testimonials__play {
    position: absolute;
    inset: 50% auto auto 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    padding: 0 0 0 4px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: #222222;
    transform: translate(-50%, -50%);
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .apex-testimonials__play:hover {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .apex-testimonials__frame.is-playing .apex-testimonials__play {
    display: none;
  }

  .apex-testimonials__quote {
    margin: 16px 0 6px;
    font-size: 16px;
    line-height: 1.4;
  }

  .apex-testimonials__author {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }

  .apex-testimonials__author span {
    font-weight: 400;
    opacity: 0.75;
  }

  .apex-testimonials__controls {
    margin-top: 32px;
  }

  .apex-testimonials__band .apex-testimonials__arrow {
    border-color: rgb(255 255 255 / 0.4);
    background: transparent;
    color: inherit;
  }

  .apex-testimonials__band .apex-pcarousel__progress {
    background: rgb(255 255 255 / 0.25);
  }

  .apex-testimonials__band .apex-pcarousel__progress span {
    background: currentColor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook testimonials",
  "tag": "section",
  "class": "apex-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "features" },
    { "type": "text", "id": "section_title", "label": "Section title", "default": "Features" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer stories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See what people are saying" },
    { "type": "range", "id": "limit", "label": "Testimonials shown", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "paragraph", "content": "Testimonials come from Content → Metaobjects → Testimonial. Upload a portrait (9:16) video in Media. Only publish genuine testimonials and keep the source accurate." },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#222222" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable animation", "default": true }
  ],
  "presets": [{ "name": "ApexCook testimonials" }]
}
{% endschema %}
