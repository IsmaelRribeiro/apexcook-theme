{%- comment -%}
  Thin utility row above the main header (Samsung-style "Support · For Business").
  Desktop only; links are right-aligned, 14px bold.
{%- endcomment -%}

<div class="apex-utility-bar">
  <ul class="apex-utility-bar__list list-unstyled">
    {%- for block in section.blocks -%}
      {%- if block.settings.label != blank -%}
        <li {{ block.shopify_attributes }}>
          <a
            class="apex-utility-bar__link"
            href="{{ block.settings.link | default: '#' }}"
            {% if block.settings.new_tab %}
              target="_blank" rel="noopener"
            {% endif %}
          >
            {{- block.settings.label | escape -}}
            {%- if block.settings.new_tab -%}
              <svg class="apex-utility-bar__arrow" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                <path d="M3 9 9 3M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            {%- endif -%}
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .apex-utility-bar {
    display: none;
    background: var(--color-background, #fff);
  }

  @media screen and (min-width: 990px) {
    .apex-utility-bar {
      display: block;
      padding: 6px 24px 0;
    }
  }

  .apex-utility-bar__list {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin: 0;
  }

  .apex-utility-bar__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.33;
    color: var(--color-foreground, #000);
    text-decoration: none;
  }

  .apex-utility-bar__link:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Utility links",
  "tag": "div",
  "class": "apex-utility-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Support"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Utility links",
      "blocks": [
        { "type": "link", "settings": { "label": "Recipes" } },
        { "type": "link", "settings": { "label": "Support" } }
      ]
    }
  ]
}
{% endschema %}
