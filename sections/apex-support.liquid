{% comment %}
  Section contract.
  Samsung "Product support" block (samsung.com/uk product pages): large left-aligned heading and a
  one-line intro (the product's apex.care_support metafield when set), then grey cards in a row,
  each with a centred outline icon, title, short text and an underlined "Learn more" link.
  @example
  <!-- Product template; anchor id "support" -->
{% endcomment %}
<div id="support" class="apex-support section section--page-width">
  <h2 class="apex-support__heading">{{ section.settings.heading | escape }}</h2>
  {%- assign care = product.metafields.apex.care_support -%}
  {%- if care != blank -%}
    <div class="apex-support__intro rte">{{ care | metafield_tag }}</div>
  {%- elsif section.settings.text != blank -%}
    <div class="apex-support__intro">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="apex-support__cards list-unstyled" role="list" style="--apex-support-cols: {{ section.blocks.size | at_most: 3 }};">
      {%- for block in section.blocks -%}
        <li class="apex-support__card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="apex-support__icon">{% render 'apex-benefit-icon', icon: block.settings.icon %}</span>
          {%- endif -%}
          <h3 class="apex-support__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<p class="apex-support__text">{{ block.settings.text | escape }}</p>{%- endif -%}
          {%- if block.settings.link != blank -%}
            <a class="apex-support__link" href="{{ block.settings.link }}">
              {{- block.settings.link_label | default: 'Learn more' | escape -}}
              <span class="visually-hidden">: {{ block.settings.title | escape }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  /* Measured from samsung.com/uk product pages ("Product support") at 1440px: 32/40px heading,
     16px intro, cards on #f7f7f7 with ~22px gap, 40px icon, 20px title, 16px text, underlined link. */
  .apex-support {
    padding-block: var(--apex-space);
  }

  .apex-support__heading {
    margin: 0 0 16px;
  }

  .apex-support__intro {
    max-width: 760px;
    font-size: 16px;
    line-height: 1.45;
  }

  .apex-support__intro p {
    margin: 0;
  }

  .apex-support__cards {
    display: grid;
    gap: 16px;
    margin: 40px 0 0;
  }

  @media screen and (min-width: 750px) {
    .apex-support__cards {
      grid-template-columns: repeat(var(--apex-support-cols, 2), minmax(0, 1fr));
      gap: 22px;
    }
  }

  .apex-support__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px 24px;
    border-radius: 8px;
    background: #f7f7f7;
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    .apex-support__card {
      padding: 44px 48px;
    }
  }

  .apex-support__icon {
    margin-bottom: 24px;
    color: #000;
  }

  .apex-support__icon .apex-benefit-icon {
    width: 40px;
    height: 40px;
  }

  .apex-support__title {
    margin: 0 0 12px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }

  @media screen and (min-width: 990px) {
    .apex-support__title {
      font-size: 20px;
    }
  }

  .apex-support__text {
    max-width: 340px;
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
  }

  .apex-support__link {
    margin-top: 32px;
    padding-bottom: 2px;
    border-bottom: 2px solid currentColor;
    color: #000;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  .apex-support__link:hover {
    color: #555;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook support",
  "tag": "section",
  "class": "apex-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product support" },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>Find answers to your questions about our products.</p>", "info": "Replaced by the product's care & support text when it has one." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Support card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "support", "label": "Headset" },
            { "value": "chat", "label": "Chat" },
            { "value": "delivery", "label": "Delivery" },
            { "value": "returns", "label": "Returns" },
            { "value": "guarantee", "label": "Shield" },
            { "value": "recipes", "label": "Chef hat" }
          ],
          "default": "support"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Product support" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "ApexCook support", "blocks": [{ "type": "link" }, { "type": "link" }] }]
}
{% endschema %}
