{%- doc -%}
  Samsung-style home product card: grey tile, image, real "viewed in the last 24 hours" line,
  title, price with genuine previous price, "Add to cart" and "Learn more", and a
  "Pairs well with this product" box with "Add both to cart".
  The pairing is the product's first available add-on (apex.addons) or, failing that, the first
  available product of `pair_collection` that is not this product.

  @param {object} product - Product to show
  @param {object} [pair_collection] - Fallback collection for the pairing
  @param {number} [views_min] - Smallest viewer count worth showing (default 5)
  @param {boolean} [show_pair] - Show the pairing box (default true)

  @example
  {% render 'apex-deal-card', product: product, pair_collection: section.settings.pair_collection %}
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign pair = null
  unless show_pair == false
    for addon in product.metafields.apex.addons.value
      if addon.available and addon.id != product.id
        assign pair = addon
        break
      endif
    endfor
    if pair == null and pair_collection != blank
      for candidate in pair_collection.products limit: 12
        if candidate.available and candidate.id != product.id
          assign pair = candidate
          break
        endif
      endfor
    endif
  endunless

  assign return_to = routes.cart_url
  if settings.apex_upsell_page != blank
    assign return_to = settings.apex_upsell_page.url | append: '?added=' | append: variant.id
  endif
-%}

<div class="apex-deal">
  <a class="apex-deal__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 300px, 70vw', alt: '' }}
    {%- endif -%}
  </a>

  {%- comment -%} Every row is always present (even empty) so cards line up row by row in the grid. {%- endcomment -%}
  <div class="apex-deal__views-slot">
    {%- render 'apex-views-line', product: product, min: views_min, class: 'apex-deal__views' -%}
  </div>
  <a class="apex-deal__title" href="{{ product.url }}">{{ product.title | escape }}</a>

  <div class="apex-deal__price">
    {% render 'apex-price-was', product: product, variant: variant %}
  </div>

  <form method="post" action="{{ routes.cart_add_url }}" class="apex-deal__actions">
    <input type="hidden" name="id" value="{{ variant.id }}">
    <input type="hidden" name="quantity" value="1">
    <input type="hidden" name="return_to" value="{{ return_to }}">
    <button type="submit" class="apex-deal__btn apex-deal__btn--primary"{% unless variant.available %} disabled{% endunless %}>
      {%- if variant.available -%}{{ 'apex.deal.add' | t }}{%- else -%}{{ 'apex.search.sold_out' | t }}{%- endif -%}
    </button>
    <a class="apex-deal__btn apex-deal__btn--outline" href="{{ product.url }}">
      {{- 'apex.deal.learn_more' | t -}}
      <span class="visually-hidden">: {{ product.title | escape }}</span>
    </a>
  </form>

  {%- if pair and variant.available -%}
    {%- liquid
      assign pair_variant = pair.selected_or_first_available_variant
      assign total = variant.price | plus: pair_variant.price
      assign was_a = variant.price
      if variant.compare_at_price > variant.price
        assign was_a = variant.compare_at_price
      endif
      assign was_b = pair_variant.price
      if pair_variant.compare_at_price > pair_variant.price
        assign was_b = pair_variant.compare_at_price
      endif
      assign was_total = was_a | plus: was_b
    -%}
    <details class="apex-deal__pair" open>
      <summary class="apex-deal__pair-head">
        <span class="apex-deal__pair-icon" aria-hidden="true"></span>
        {{ 'apex.deal.pairs_well' | t }}
      </summary>
      <div class="apex-deal__pair-body">
        <div class="apex-deal__pair-item">
          <a class="apex-deal__pair-media" href="{{ pair.url }}" tabindex="-1" aria-hidden="true">
            {%- if pair.featured_image -%}
              {{ pair.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', sizes: '96px' }}
            {%- endif -%}
          </a>
          <div class="apex-deal__pair-info">
            <a class="apex-deal__pair-title" href="{{ pair.url }}">{{ pair.title | escape }}</a>
            <p class="apex-deal__pair-price">
              {{ pair_variant.price | money }}
              {%- if pair_variant.compare_at_price > pair_variant.price -%}
                <s><span class="visually-hidden">{{ 'apex.deal.was' | t }} </span>{{ pair_variant.compare_at_price | money }}</s>
              {%- endif -%}
            </p>
            <a class="apex-deal__btn apex-deal__btn--outline apex-deal__btn--small" href="{{ pair.url }}">
              {{- 'apex.deal.learn_more' | t -}}
              <span class="visually-hidden">: {{ pair.title | escape }}</span>
            </a>
          </div>
        </div>

        <div class="apex-deal__total">
          <span>{{ 'apex.deal.total_both' | t }}</span>
          <span class="apex-deal__total-price">
            <strong>{{ total | money }}</strong>
            {%- if was_total > total -%}
              <s><span class="visually-hidden">{{ 'apex.deal.was' | t }} </span>{{ was_total | money }}</s>
            {%- endif -%}
          </span>
        </div>

        <form method="post" action="{{ routes.cart_add_url }}">
          <input type="hidden" name="items[0][id]" value="{{ variant.id }}">
          <input type="hidden" name="items[0][quantity]" value="1">
          <input type="hidden" name="items[1][id]" value="{{ pair_variant.id }}">
          <input type="hidden" name="items[1][quantity]" value="1">
          <input type="hidden" name="return_to" value="{{ return_to }}">
          <button type="submit" class="apex-deal__btn apex-deal__btn--primary apex-deal__btn--block">
            {{- 'apex.deal.add_both' | t -}}
          </button>
        </form>
      </div>
    </details>
  {%- else -%}
    <div class="apex-deal__pair-slot" aria-hidden="true"></div>
  {%- endif -%}
</div>

{% stylesheet %}
  /* Sizes measured from samsung.com/uk/offer/black-friday (1440px): 395px cards, 20px padding,
     13/15/18/14px type. Weights capped at semibold and corners square, as in the rest of ApexCook. */
  .apex-deal {
    display: grid;
    grid-template-rows: auto auto auto auto auto 1fr;
    align-content: start;
    height: 100%;
    padding: 20px;
    background: #F7F7F7;
    color: #222222;
  }

  /* Inside the carousel the six rows (image, views, title, price, buttons, pairs well) are shared
     by all cards through subgrid, so every row starts at the same height in every card. */
  .apex-pcarousel__item--deal > .apex-deal {
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: 0;
  }

  .apex-deal__media {
    display: block;
    height: 200px;
    margin-bottom: 16px;
    padding-block: 4px;
  }

  .apex-deal__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .apex-deal__views-slot {
    min-height: 0;
  }

  .apex-deal .apex-views {
    margin: 0 0 6px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    color: #E00B41;
  }

  .apex-deal__title {
    min-height: calc(2 * 1.35em);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    color: inherit;
    text-decoration: none;
  }

  .apex-deal__title:hover {
    text-decoration: underline;
  }

  .apex-deal__price {
    margin: 6px 0 14px;
  }

  .apex-deal__price .apex-price {
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  .apex-deal__price .apex-price__now {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }

  .apex-deal__price .apex-price__was {
    font-size: 15px;
  }

  .apex-deal__actions {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .apex-deal__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 9px 24px 10px;
    border: 1px solid #222222;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .apex-deal__btn--primary {
    background: #222222;
    color: #fff;
  }

  .apex-deal__btn--primary:hover {
    background: #222222;
  }

  .apex-deal__btn--primary:disabled {
    border-color: #DDDDDD;
    background: #DDDDDD;
    color: #6A6A6A;
    cursor: not-allowed;
  }

  .apex-deal__btn--outline {
    background: transparent;
    color: #222222;
  }

  .apex-deal__btn--outline:hover {
    background: #222222;
    color: #fff;
  }

  .apex-deal__btn--small {
    align-self: flex-start;
    margin-top: 8px;
    padding-inline: 24px;
    white-space: nowrap;
  }

  .apex-deal__btn--block {
    width: 100%;
  }

  /* Pairs well box: 8px wider than the card content, white, light blue-grey header */
  .apex-deal__pair {
    align-self: start;
    margin: 20px -8px -8px;
    border: 1px solid #e8ebf3;
    background: #fff;
  }

  .apex-deal__pair-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    background: #f4f6fb;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
  }

  .apex-deal__pair-head::-webkit-details-marker {
    display: none;
  }

  .apex-deal__pair-icon {
    position: relative;
    flex: none;
    width: 24px;
    height: 24px;
    border: 1px solid #dadada;
    border-radius: 50%;
    background: #fff;
  }

  .apex-deal__pair-icon::before,
  .apex-deal__pair-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 1.5px;
    background: #222222;
    transform: translate(-50%, -50%);
  }

  .apex-deal__pair-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 0.2s ease;
  }

  .apex-deal__pair[open] .apex-deal__pair-icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .apex-deal__pair-body {
    display: grid;
    padding-top: 16px;
  }

  .apex-deal__pair-item {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 12px;
    margin: 0 16px 20px;
  }

  .apex-deal__pair-media {
    display: block;
    width: 96px;
    height: 96px;
    padding: 6px;
    background: #fff;
  }

  .apex-deal__pair-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .apex-deal__pair-info {
    display: flex;
    flex-direction: column;
    padding-top: 6px;
  }

  .apex-deal__pair-title {
    display: -webkit-box;
    min-height: calc(2 * 1.3em);
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    color: inherit;
    text-decoration: none;
  }

  .apex-deal__pair-price {
    display: flex;
    flex-direction: column;
    min-height: calc(2 * 1.3em);
    margin: 2px 0 0;
    font-size: 13px;
    line-height: 1.3;
    color: #6A6A6A;
  }

  .apex-deal__total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 16px 12px;
    padding: 12px 14px;
    border: 1px solid #EBEBEB;
    background: #F7F7F7;
    font-size: 13px;
    font-weight: 600;
    color: #222222;
  }

  .apex-deal__total-price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    min-height: calc(16px * 1.3 + 13px * 1.3 + 1px);
  }

  .apex-deal__total-price strong,
  .apex-deal__total-price s {
    line-height: 1.3;
  }

  .apex-deal__total-price strong {
    font-size: 16px;
    font-weight: 600;
    color: #222222;
  }

  .apex-deal__total-price s {
    font-size: 13px;
    font-weight: 400;
    color: #6A6A6A;
  }

  .apex-deal__pair form {
    margin: 0 16px 16px;
  }
{% endstylesheet %}
