{% comment %}
  Section contract.
  Care and support: care instructions from the product's apex.care_support metafield, plus links
  to delivery, returns, guarantee and contact.
  @example
  <!-- Product template; anchor id "support" -->
{% endcomment %}
<div id="support" class="apex-support section section--page-width">
  <div class="apex-support__grid">
    <div>
      <h2 class="apex-support__heading">{{ section.settings.heading | escape }}</h2>
      {%- assign care = product.metafields.apex.care_support -%}
      {%- if care != blank -%}
        <div class="rte">{{ care | metafield_tag }}</div>
      {%- endif -%}
    </div>
    <ul class="apex-support__links" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link }}">
            <strong>{{ block.settings.title | escape }}</strong>
            {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .apex-support {
    padding-block: 48px;
  }

  .apex-support__grid {
    display: grid;
    gap: 32px;
  }

  .apex-support__heading {
    margin: 0 0 16px;
  }

  .apex-support__links {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .apex-support__links a {
    display: grid;
    gap: 4px;
    padding: 16px;
    background: rgb(var(--color-foreground-rgb) / 0.04);
    color: inherit;
    text-decoration: none;
  }

  .apex-support__links span {
    font-size: 0.875rem;
    opacity: 0.75;
  }

  @media screen and (min-width: 990px) {
    .apex-support__grid {
      grid-template-columns: 3fr 2fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook support",
  "tag": "section",
  "class": "apex-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Care & support" }],
  "blocks": [
    {
      "type": "link",
      "name": "Support link",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Delivery" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "ApexCook support" }]
}
{% endschema %}
