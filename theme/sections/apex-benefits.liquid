{% comment %}
  Section contract.
  "Join ApexCook" benefit cards: icon, title, short text and an optional link. Used on Home, PDP and About.
  @example
  <!-- Add "ApexCook benefits" and add up to 4 benefit blocks -->
{% endcomment %}
{%- if section.settings.enable_animation -%}{% render 'apex-motion-styles' %}{%- endif -%}
<div class="apex-benefits apex-benefits--{{ section.settings.alignment | default: 'left' }} section section--page-width">
  <div>
    {%- if section.settings.heading != blank -%}
      <h2 class="apex-benefits__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="apex-benefits__list" role="list">
      {%- for block in section.blocks -%}
        <li
          class="apex-benefits__card"
          {{ block.shopify_attributes }}
        >
          <span class="apex-benefits__icon-tile">
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', class: 'apex-benefits__icon' }}
            {%- else -%}
              {% render 'apex-benefit-icon', icon: block.settings.icon_name %}
            {%- endif -%}
          </span>
          <h3 class="apex-benefits__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="apex-benefits__text">{{ block.settings.text | escape }}</p>
          {%- else -%}
            <span aria-hidden="true"></span>
          {%- endif -%}
          {%- if block.settings.link != blank and block.settings.link_label != blank -%}
            <a class="apex-benefits__link" href="{{ block.settings.link }}">
              {{- block.settings.link_label | escape -}}
              <span class="visually-hidden">: {{ block.settings.title | escape }}</span>
            </a>
          {%- else -%}
            <span aria-hidden="true"></span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  /* Samsung "Buy direct. Get more." cards: white, hairline border, blue outline icon on a pale tile,
     title / text / link rows aligned across cards with subgrid. Square corners for ApexCook. */
  .apex-benefits {
    padding-block: 48px;
  }

  .apex-benefits__heading {
    margin: 0 0 32px;
  }

  .apex-benefits--center .apex-benefits__heading {
    text-align: center;
  }

  .apex-benefits__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: auto auto 1fr auto;
    gap: 0 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .apex-benefits__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .apex-benefits__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0 24px;
    }
  }

  .apex-benefits__card {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0;
    margin-bottom: 16px;
    padding: 28px 28px 32px;
    border: 1px solid #ddd;
    background: #fff;
    color: #000;
    text-align: start;
  }

  .apex-benefits__icon-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    margin-bottom: 22px;
    background: #f2f6fd;
    color: #2189ff;
  }

  .apex-benefit-icon {
    display: block;
    width: 32px;
    height: 32px;
  }

  .apex-benefits__icon {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .apex-benefits__title {
    margin: 0 0 14px;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.33;
  }

  @media screen and (min-width: 990px) {
    .apex-benefits__title {
      font-size: 22px;
    }
  }

  .apex-benefits__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.33;
    color: #000;
  }

  .apex-benefits__link {
    justify-self: start;
    margin-top: 32px;
    padding-bottom: 2px;
    border-bottom: 2px solid currentColor;
    color: #000;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.33;
    text-decoration: none;
  }

  .apex-benefits__link:hover {
    color: #555;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook benefits",
  "tag": "section",
  "class": "apex-section",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join ApexCook. Enjoy the benefits" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable animation", "default": true }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon_name",
          "label": "Icon",
          "options": [
            { "value": "delivery", "label": "Delivery" },
            { "value": "returns", "label": "Returns" },
            { "value": "guarantee", "label": "Guarantee" },
            { "value": "secure", "label": "Secure checkout" },
            { "value": "payment", "label": "Payment" },
            { "value": "support", "label": "Support" },
            { "value": "recipes", "label": "Recipes" },
            { "value": "rewards", "label": "Rewards" }
          ],
          "default": "delivery"
        },
        { "type": "image_picker", "id": "icon", "label": "Custom icon", "info": "Overrides the icon above." },
        { "type": "text", "id": "title", "label": "Title", "default": "Free UK delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "On orders over £50." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ApexCook benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon_name": "delivery", "title": "Free UK delivery", "text": "On orders over £50." } },
        { "type": "benefit", "settings": { "icon_name": "returns", "title": "30-day returns", "text": "Changed your mind? Send it back within 30 days." } },
        { "type": "benefit", "settings": { "icon_name": "guarantee", "title": "10-year guarantee", "text": "Built to last, backed for a decade." } },
        { "type": "benefit", "settings": { "icon_name": "secure", "title": "Secure checkout", "text": "Apple Pay, Google Pay, Shop Pay and cards." } }
      ]
    }
  ]
}
{% endschema %}
