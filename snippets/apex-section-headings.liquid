{%- doc -%}
  One size for every section title across the ApexCook sections: 32px semibold
  (26px on phones). Page H1s (hero, collection) and banner headlines keep their own sizes.

  @example
  {% render 'apex-section-headings' %}
{%- enddoc -%}

{% stylesheet %}
  body .shopify-section :is(
    .apex-benefits__heading,
    .apex-bento__heading,
    .apex-compare-slider__heading,
    .apex-compare__heading,
    .apex-cooked-with__heading,
    .apex-faq__heading,
    .apex-highlights__heading,
    .apex-pcarousel__heading,
    .apex-press__heading,
    .apex-recipes__heading,
    .apex-reviews__heading,
    .apex-specs__heading,
    .apex-story__heading,
    .apex-support__heading,
    .apex-testimonials__heading,
    .apex-uses__heading
  ) {
    font-size: 26px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: normal;
  }

  @media screen and (min-width: 750px) {
    body .shopify-section :is(
      .apex-benefits__heading,
      .apex-bento__heading,
      .apex-compare-slider__heading,
      .apex-compare__heading,
      .apex-cooked-with__heading,
      .apex-faq__heading,
      .apex-highlights__heading,
      .apex-pcarousel__heading,
      .apex-press__heading,
      .apex-recipes__heading,
      .apex-reviews__heading,
      .apex-specs__heading,
      .apex-story__heading,
      .apex-support__heading,
      .apex-testimonials__heading,
      .apex-uses__heading
    ) {
      font-size: 32px;
    }
  }
{% endstylesheet %}
