{% comment %}
  Section contract.
  Samsung-style sticky product bar. Left: product name, star rating and the Features · Specs ·
  Reviews · Support tabs. Right: price, previous price / saving and "Buy now", which scrolls to
  the buy box.
  @example
  <!-- Product template, above the main product section -->
{% endcomment %}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  capture summary
    render 'apex-reviews-collect', product: product, mode: 'summary'
  endcapture
  assign parts = summary | strip | split: '|'
  assign count = parts[0] | plus: 0
  assign sum = parts[1] | plus: 0
-%}
<script src="{{ 'apex-nav-price.js' | asset_url }}" type="module" fetchpriority="low"></script>
<nav class="apex-anchor-nav" aria-label="{{ 'apex.nav.label' | t }}">
  <div class="section section--page-width">
    <div class="apex-anchor-nav__grid">
      <div class="apex-anchor-nav__info">
        {%- assign promo = product.metafields.apex.promo_line.value -%}
        {%- comment -%} Real "viewed in the last 24 hours" figure when available, otherwise the promo line. {%- endcomment -%}
        {%- capture views_line -%}
          {%- if section.settings.show_views -%}
            {%- render 'apex-views-line', product: product, min: section.settings.views_min, class: 'apex-anchor-nav__promo apex-anchor-nav__views' -%}
          {%- endif -%}
        {%- endcapture -%}
        {%- if views_line != blank -%}
          {{ views_line }}
        {%- elsif promo != blank -%}
          <p class="apex-anchor-nav__promo">{{ promo | escape }}</p>
        {%- endif -%}
        <h1 class="apex-anchor-nav__title">{{ product.title | escape }}</h1>
        {%- if count > 0 -%}
          {%- assign average = sum | times: 10.0 | divided_by: count | round | divided_by: 10.0 -%}
          <a class="apex-anchor-nav__rating" href="#reviews">
            {% render 'apex-stars', rating: average %}
            <span>{{ average }} ({{ count }})</span>
          </a>
        {%- endif -%}
      </div>
      <div class="apex-anchor-nav__buy">
        <div class="apex-anchor-nav__price" data-apex-nav-price>
          {% render 'apex-price-was', product: product, variant: variant, compact: true %}
        </div>
        <a class="apex-anchor-nav__cta" href="#buy">{{ 'apex.nav.buy' | t }}</a>
      </div>
      <ul class="apex-anchor-nav__links" role="list">
        {%- if section.settings.show_features -%}
          <li><a href="#features">{{ 'apex.nav.features' | t }}</a></li>
        {%- endif -%}
        {%- if product.metafields.apex.specs != blank -%}
          <li><a href="#specs">{{ 'apex.nav.specs' | t }}</a></li>
        {%- endif -%}
        <li><a href="#reviews">{{ 'apex.nav.reviews' | t }}</a></li>
        <li><a href="#support">{{ 'apex.nav.support' | t }}</a></li>
      </ul>
    </div>
  </div>
</nav>

{% stylesheet %}
  /* Compact state once scrolled (Samsung-style): promo line and rating collapse (tablet/desktop). */
  @media screen and (min-width: 750px) {
    .apex-anchor-nav.is-compact .apex-anchor-nav__promo,
    .apex-anchor-nav.is-compact .apex-anchor-nav__rating {
      display: none;
    }

    .apex-anchor-nav.is-compact .apex-anchor-nav__grid {
      padding-block-start: 10px;
    }
  }

  /* The section wrapper is the sticky element: the nav alone is as tall as its parent. */
  .shopify-section.apex-section:not(.header-section):has(> .apex-anchor-nav) {
    position: sticky;
    top: 0;
    z-index: 4;
  }

  .apex-anchor-nav {
    background: var(--color-background);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  body:has(#header-component[sticky='always']) .shopify-section.apex-section:not(.header-section):has(> .apex-anchor-nav),
  body:has(#header-component[data-sticky-state='active']) .shopify-section.apex-section:not(.header-section):has(> .apex-anchor-nav) {
    top: calc(var(--header-height, 60px) - 1px);
  }

  .apex-anchor-nav__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'info buy' 'links links';
    align-items: center;
    gap: 4px 24px;
    padding-block: 16px 0;
  }

  .apex-anchor-nav__info {
    grid-area: info;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    min-width: 0;
  }

  .apex-anchor-nav__promo {
    flex-basis: 100%;
    margin: 0;
    color: var(--color-primary-button-background);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .apex-anchor-nav__title {
    flex-basis: 100%;
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .apex-anchor-nav__rating {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    font-size: 0.75rem;
    text-decoration: none;
  }

  .apex-anchor-nav__buy {
    grid-area: buy;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .apex-anchor-nav__price {
    display: none;
  }

  .apex-anchor-nav__price .apex-price {
    justify-content: flex-end;
    gap: 0 8px;
    line-height: 1.2;
  }

  .apex-anchor-nav__price .apex-price__now {
    flex-basis: 100%;
    text-align: end;
    font-size: 1.125rem;
  }

  .apex-anchor-nav__cta {
    padding: 10px 20px;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .apex-anchor-nav__links {
    grid-area: links;
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 8px 0 10px;
    overflow-x: auto;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 600;
    scrollbar-width: none;
  }

  .apex-anchor-nav__links a {
    color: inherit;
    white-space: nowrap;
    text-decoration: none;
  }

  .apex-anchor-nav__links a:hover {
    text-decoration: underline;
  }

  @media screen and (min-width: 750px) {
    .apex-anchor-nav__price {
      display: block;
    }

    .apex-anchor-nav__title {
      font-size: clamp(1.25rem, 2vw, 1.75rem);
    }
  }

  html {
    scroll-padding-top: 120px;
  }

  /* Phones, as on samsung.com/uk product pages: the name, rating and promo line scroll away while
     the tab row stays pinned at the top of the screen; the header scrolls away (the section sticks with a negative offset equal to
     the height above the tabs, measured by apex-nav-price.js), and the price + "Buy now" sit in a
     bar fixed to the bottom of the screen. */
  @media screen and (max-width: 749px) {
    .shopify-section.apex-section:not(.header-section):has(> .apex-anchor-nav),
    body:has(#header-component[sticky='always']) .shopify-section.apex-section:not(.header-section):has(> .apex-anchor-nav),
    body:has(#header-component[data-sticky-state='active']) .shopify-section.apex-section:not(.header-section):has(> .apex-anchor-nav) {
      top: calc(var(--apex-nav-sticky-top, 0px) - var(--apex-nav-links-top, 0px));
    }

    .apex-anchor-nav__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'info' 'links';
      padding-block-start: 20px;
    }

    .apex-anchor-nav__title {
      font-size: 24px;
      line-height: 1.25;
    }

    .apex-anchor-nav__rating {
      font-size: 14px;
    }

    .apex-anchor-nav__links {
      margin-top: 12px;
      padding-block: 12px;
      font-size: 15px;
    }

    .apex-anchor-nav__buy {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 6;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 24px calc(14px + env(safe-area-inset-bottom));
      border-top: 1px solid #ddd;
      background: #fff;
      box-shadow: 0 -4px 16px rgb(0 0 0 / 0.06);
    }

    .apex-anchor-nav__price {
      display: block;
    }

    .apex-anchor-nav__price .apex-price {
      justify-content: flex-start;
    }

    .apex-anchor-nav__price .apex-price__now {
      text-align: start;
      font-size: 20px;
    }

    .apex-anchor-nav__price .apex-price__was,
    .apex-anchor-nav__price .apex-price__save {
      font-size: 13px;
    }

    .apex-anchor-nav__cta {
      padding: 12px 24px;
      font-size: 15px;
    }

    /* The site header scrolls away on product pages; only the tab row stays pinned. */
    body:has(.apex-anchor-nav) .header-section:has(> #header-component) {
      position: relative;
      top: auto;
    }

    /* Room for the bottom bar so the footer is not hidden behind it. */
    body:has(.apex-anchor-nav) {
      padding-bottom: 80px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook product nav",
  "tag": "section",
  "class": "apex-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "checkbox", "id": "show_features", "label": "Show 'Features' tab", "default": true },
    { "type": "checkbox", "id": "show_views", "label": "Show 'viewed in the last 24 hours' tag", "default": true, "info": "Uses the real visitor count stored on the product (updated from Shopify Analytics)." },
    { "type": "range", "id": "views_min", "label": "Show the tag from", "min": 1, "max": 50, "step": 1, "default": 5, "unit": "ppl" }
  ],
  "presets": [{ "name": "ApexCook product nav" }]
}
{% endschema %}
