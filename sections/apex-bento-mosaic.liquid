{% comment %}
  Section contract.
  "Black Shop" mosaic: a heading plus one large tile and up to four small tiles. Each tile shows a
  picked product (photo, name, price, link) or a plain linked image.
  Desktop: large tile spans two rows beside a 2×2 grid. Mobile: large tile on top, 2×2 below.
  @example
  <!-- Add "ApexCook mosaic" and add up to 5 tiles; the first tile is the large one -->
{% endcomment %}
{%- if section.settings.enable_animation -%}{% render 'apex-motion-styles' %}{%- endif -%}
<div class="apex-bento section section--page-width">
  <div>
    {%- if section.settings.heading != blank -%}
      <h2 class="apex-bento__heading" {% if section.settings.enable_animation %}data-apex-reveal{% endif %}>
        {{- section.settings.heading | escape -}}
      </h2>
    {%- endif -%}
    <div class="apex-bento__grid">
      {%- for block in section.blocks limit: 5 -%}
        {%- liquid
          assign p = block.settings.product
          assign link = block.settings.link
          if p != blank and link == blank
            assign link = p.url
          endif
          assign tag = 'div'
          if link != blank
            assign tag = 'a'
          endif
          if forloop.first
            assign sizes = '(min-width: 750px) 50vw, 100vw'
          else
            assign sizes = '(min-width: 750px) 25vw, 50vw'
          endif
          assign img = block.settings.image
          if img == blank and p != blank
            assign img = p.featured_image
          endif
          assign alt = block.settings.label | default: p.title
        -%}
        <{{ tag }}
          class="apex-bento__tile{% if forloop.first %} apex-bento__tile--large{% endif %}{% if p != blank %} apex-bento__tile--product{% endif %}"
          {% if link != blank %}href="{{ link }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if p != blank -%}
            <span class="apex-bento__info">
              <span class="apex-bento__name">{{ p.title | escape }}</span>
              {%- render 'apex-price-was', product: p, variant: p.selected_or_first_available_variant, compact: true -%}
            </span>
          {%- endif -%}
          {%- if img != blank -%}
            {{
              img
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400, 700, 1000, 1400',
                sizes: sizes,
                alt: alt,
                class: 'apex-bento__image'
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'apex-bento__image' }}
          {%- endif -%}
          {%- if block.settings.label != blank and p == blank -%}
            <span class="visually-hidden">{{ block.settings.label | escape }}</span>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .apex-bento {
    padding-block: 48px;
  }

  .apex-bento__heading {
    margin: 0 0 32px;
    text-align: center;
  }

  .apex-bento__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .apex-bento__tile {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    min-width: 0;
  }

  .apex-bento__tile--large {
    grid-column: 1 / -1;
  }

  .apex-bento__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  a.apex-bento__tile:hover .apex-bento__image {
    transform: scale(1.03);
  }

  @media screen and (min-width: 750px) {
    .apex-bento__grid {
      grid-template-columns: 2fr 1fr 1fr;
      grid-auto-rows: 1fr;
      gap: 16px;
    }

    .apex-bento__tile--large {
      grid-column: 1;
      grid-row: span 2;
      aspect-ratio: auto;
    }
  }

  /* Product tiles: grey card, name and price top-left, product photo below. */
  .apex-bento__tile--product {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 20px;
    border-radius: 8px;
    background: #f7f7f7;
    color: #222222;
    text-decoration: none;
  }

  .apex-bento__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
    z-index: 1;
  }

  .apex-bento__name {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }

  .apex-bento__tile--large .apex-bento__name {
    font-size: clamp(20px, 2vw, 28px);
  }

  .apex-bento__tile--product .apex-bento__image {
    flex: 1 1 0;
    height: 0;
    min-height: 0;
    margin-top: 12px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  @media screen and (max-width: 749px) {
    .apex-bento__tile--product {
      padding: 14px;
    }

    .apex-bento__name {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-bento__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook mosaic",
  "tag": "section",
  "class": "apex-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Shop: ApexCook deals in one place" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable animation", "default": true }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Shows the product's photo, name and price, and links to it." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Replaces the product photo." },
        { "type": "text", "id": "label", "label": "Accessible label", "info": "Describes the image and link for screen readers." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ApexCook mosaic",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
