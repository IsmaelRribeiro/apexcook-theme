{%- doc -%}
  Feature / benefit icons from Phosphor Icons (light weight, MIT licence – phosphoricons.com).

  @param {string} icon - delivery | returns | guarantee | secure | payment | support | recipes | rewards | pan | leaf | flame | dishwasher

  @example
  {% render 'apex-benefit-icon', icon: 'delivery' %}
{%- enddoc -%}
{%- liquid
  case icon
    when 'delivery'
      assign file = 'ph-truck-light.svg'
    when 'returns'
      assign file = 'ph-arrow-counter-clockwise-light.svg'
    when 'guarantee'
      assign file = 'ph-shield-check-light.svg'
    when 'secure'
      assign file = 'ph-lock-simple-light.svg'
    when 'payment'
      assign file = 'ph-wallet-light.svg'
    when 'support'
      assign file = 'ph-headset-light.svg'
    when 'recipes'
      assign file = 'ph-chef-hat-light.svg'
    when 'pan'
      assign file = 'ph-cooking-pot-light.svg'
    when 'leaf'
      assign file = 'ph-leaf-light.svg'
    when 'flame'
      assign file = 'ph-fire-light.svg'
    when 'dishwasher'
      assign file = 'ph-drop-light.svg'
    else
      assign file = 'ph-sparkle-light.svg'
  endcase
-%}
{{- file | inline_asset_content | replace: '<svg ', '<svg class="apex-benefit-icon" width="32" height="32" ' -}}
