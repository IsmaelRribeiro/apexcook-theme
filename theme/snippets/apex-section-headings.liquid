{%- doc -%}
  One size for every section title across the ApexCook sections, matched to Samsung UK:
  25px on phones, 32px on tablets, 40px on desktop; semibold (nothing heavier than 600). Page H1s (hero, collection) and banner headlines keep their own sizes.

  @example
  {% render 'apex-section-headings' %}
{%- enddoc -%}

{% stylesheet %}
  /* 16px corners on ApexCook cards, buttons, fields, chips and the images inside them. Full-width
     bands, bars, progress tracks and round icon buttons keep their own shape. */
  .apex-benefits__card,
  .apex-benefits__icon-tile,
  .apex-highlights__card,
  .apex-chefs__card,
  .apex-chefs__img,
  .apex-testimonials__frame,
  .apex-deal,
  .apex-deal__pair,
  .apex-deal__btn,
  .apex-deal__pair-media,
  .apex-pcarousel__media,
  .apex-card-cta__button,
  .apex-cc__img img,
  .apex-cc__ph,
  .apex-cc__more,
  .apex-cmp__stage,
  .apex-buy-box,
  .apex-buy-box__submit,
  .apex-buy-box__clear,
  .apex-addons__more,
  .apex-anchor-nav__cta,
  .apex-precheck__card,
  .apex-precheck__link,
  .apex-size-guide__panel,
  .apex-size-guide__link,
  .apex-tool__btn,
  .apex-tool__media,
  .apex-rpage__fact,
  .apex-rpage__share-btn,
  .apex-rpage__other,
  .apex-rpage__other-media,
  .apex-rpage__photo,
  .apex-pcard,
  .apex-pcard__media,
  .apex-pantry__button,
  .apex-pantry__arrow,
  .apex-pantry__tab,
  .apex-pantry__search input[type='search'],
  .apex-pantry__search button,
  .apex-recipes__tags a,
  .apex-support__links a,
  .apex-sr__card,
  .apex-sr__image,
  .apex-sr__chip,
  .apex-sr__cta,
  .apex-sr__more,
  .apex-sr__filters-btn,
  .apex-sr__confirm,
  .apex-sr__option,
  .apex-sr__search input[type='search'],
  .apex-sr__sort select,
  .apex-search__thumb-image,
  .apex-plp__cat-link,
  .apex-plp__promo,
  .apex-up__continue,
  .apex-empty-cta__button,
  .apex-media-banner__button,
  .apex-split-hero__button,
  .apex-mobile-checkout__button,
  .apex-mnav__search-input,
  .apex-trust__item,
  .apex-free-delivery__track,
  .apex-free-delivery__fill,
  .apex-accordion__expand {
    border-radius: 16px;
  }

  .apex-chefs__img,
  .apex-tool__media img,
  .apex-pcard__media img,
  .apex-rpage__other-media img,
  .apex-rpage__photo img,
  .apex-pcarousel__media img,
  .apex-testimonials__media {
    border-radius: inherit;
  }

  .apex-testimonials__frame,
  .apex-tool__media,
  .apex-pcard__media,
  .apex-rpage__other,
  .apex-rpage__photo,
  .apex-cmp__stage {
    overflow: hidden;
  }

  /* Keep off-screen carousel content (and its visually-hidden labels) from widening the page. */
  html,
  body {
    overflow-x: clip;
  }

  [data-track] > li,
  .apex-pcarousel__item {
    position: relative;
  }

  /* One vertical rhythm for ApexCook sections: 48px top/bottom on phones, 64px from 990px. */
  :root {
    --apex-space: 48px;
  }

  @media screen and (min-width: 990px) {
    :root {
      --apex-space: 64px;
    }
  }

  body .shopify-section :is(
    .apex-benefits__heading,
    .apex-chefs__heading,
    .apex-cc__heading,
    .apex-cmp__heading,
    .apex-fh__opener-title,
    .apex-bento__heading,
    .apex-compare-slider__heading,
    .apex-compare__heading,
    .apex-cooked-with__heading,
    .apex-faq__heading,
    .apex-highlights__heading,
    .apex-pcarousel__heading,
    .apex-press__heading,
    .apex-recipes__heading,
    .apex-reviews__heading,
    .apex-specs__heading,
    .apex-story__heading,
    .apex-support__heading,
    .apex-testimonials__heading,
    .apex-uses__heading
  ) {
    font-size: 25px;
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: normal;
  }

  @media screen and (min-width: 750px) {
    body .shopify-section :is(
      .apex-benefits__heading,
    .apex-chefs__heading,
    .apex-cc__heading,
    .apex-cmp__heading,
    .apex-fh__opener-title,
      .apex-bento__heading,
      .apex-compare-slider__heading,
      .apex-compare__heading,
      .apex-cooked-with__heading,
      .apex-faq__heading,
      .apex-highlights__heading,
      .apex-pcarousel__heading,
      .apex-press__heading,
      .apex-recipes__heading,
      .apex-reviews__heading,
      .apex-specs__heading,
      .apex-story__heading,
      .apex-support__heading,
      .apex-testimonials__heading,
      .apex-uses__heading
    ) {
      font-size: 32px;
    }
  }

  @media screen and (min-width: 990px) {
    body .shopify-section :is(
      .apex-benefits__heading,
    .apex-chefs__heading,
    .apex-cc__heading,
    .apex-cmp__heading,
    .apex-fh__opener-title,
      .apex-bento__heading,
      .apex-compare-slider__heading,
      .apex-compare__heading,
      .apex-cooked-with__heading,
      .apex-faq__heading,
      .apex-highlights__heading,
      .apex-pcarousel__heading,
      .apex-press__heading,
      .apex-recipes__heading,
      .apex-reviews__heading,
      .apex-specs__heading,
      .apex-story__heading,
      .apex-support__heading,
      .apex-testimonials__heading,
      .apex-uses__heading
    ) {
      font-size: 40px;
    }
  }
{% endstylesheet %}
