{% comment %}
  Section contract.
  Sticky product sub-navigation: Features · Specs · Reviews · Support, "See how it compares", and a
  compact name + price + Buy button that scrolls to the buy box.
  @example
  <!-- Product template, above the main product section -->
{% endcomment %}
{%- assign variant = product.selected_or_first_available_variant -%}
<nav class="apex-anchor-nav" aria-label="{{ 'apex.nav.label' | t }}">
  <div class="apex-anchor-nav__inner section section--page-width">
    <div class="apex-anchor-nav__row">
      <p class="apex-anchor-nav__title">{{ product.title | escape }}</p>
      <ul class="apex-anchor-nav__links" role="list">
        <li><a href="#features">{{ 'apex.nav.features' | t }}</a></li>
        <li><a href="#specs">{{ 'apex.nav.specs' | t }}</a></li>
        <li><a href="#reviews">{{ 'apex.nav.reviews' | t }}</a></li>
        <li><a href="#support">{{ 'apex.nav.support' | t }}</a></li>
        <li><a href="#compare">{{ 'apex.nav.compare' | t }}</a></li>
      </ul>
      <div class="apex-anchor-nav__buy">
        <span class="apex-anchor-nav__price">{{ variant.price | money }}</span>
        <a class="apex-anchor-nav__cta" href="#{{ section.settings.buy_box_anchor | default: 'buy' }}">{{ 'apex.nav.buy' | t }}</a>
      </div>
    </div>
  </div>
</nav>

{% stylesheet %}
  .apex-anchor-nav {
    position: sticky;
    top: 0;
    z-index: 4;
    background: var(--color-background);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .apex-anchor-nav__row {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 56px;
  }

  .apex-anchor-nav__title {
    display: none;
    margin: 0;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 28ch;
  }

  .apex-anchor-nav__links {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    font-size: 0.875rem;
    scrollbar-width: none;
  }

  .apex-anchor-nav__links a {
    color: inherit;
    white-space: nowrap;
    text-decoration: none;
  }

  .apex-anchor-nav__links a:hover {
    text-decoration: underline;
  }

  .apex-anchor-nav__buy {
    display: none;
    align-items: center;
    gap: 12px;
    margin-inline-start: auto;
  }

  .apex-anchor-nav__cta {
    padding: 8px 16px;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    font-weight: 600;
    text-decoration: none;
  }

  @media screen and (min-width: 990px) {
    .apex-anchor-nav__title,
    .apex-anchor-nav__buy {
      display: flex;
    }
  }

  html {
    scroll-padding-top: 72px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook product nav",
  "tag": "section",
  "class": "apex-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "buy_box_anchor", "label": "Buy box anchor id", "default": "buy" }
  ],
  "presets": [{ "name": "ApexCook product nav" }]
}
{% endschema %}
