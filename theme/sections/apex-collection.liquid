    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo tile",
      "settings": [
        {
          "type": "range",
          "id": "position",
          "label": "Position in the grid",
          "min": 1,
          "max": 24,
          "step": 1,
          "default": 4
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "dark", "label": "Dark" },
            { "value": "light", "label": "Light" }
          ],
          "default": "dark"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Bundle and save"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Build your kit with a set and pay less than buying the pans one by one."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop sets"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ]
}
{% endschema %}
