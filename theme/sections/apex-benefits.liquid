{% comment %}
  Section contract.
  "Join ApexCook" benefit cards: icon, title, short text and an optional link. Used on Home, PDP and About.
  @example
  <!-- Add "ApexCook benefits" and add up to 4 benefit blocks -->
{% endcomment %}
{%- if section.settings.enable_animation -%}{% render 'apex-motion-styles' %}{%- endif -%}
<div class="apex-benefits apex-benefits--{{ section.settings.alignment | default: 'left' }} section section--page-width">
  <div>
    {%- if section.settings.heading != blank -%}
      <h2 class="apex-benefits__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="apex-benefits__list" role="list">
      {%- for block in section.blocks -%}
        <li
          class="apex-benefits__card"
          {% if section.settings.enable_animation %}data-apex-reveal style="--apex-reveal-index: {{ forloop.index0 }};"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.icon != blank -%}
            {{ block.settings.icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', class: 'apex-benefits__icon' }}
          {%- endif -%}
          <h3 class="apex-benefits__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="apex-benefits__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.link != blank and block.settings.link_label != blank -%}
            <a class="apex-benefits__link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .apex-benefits {
    padding-block: 48px;
  }

  .apex-benefits__heading {
    margin: 0 0 24px;
  }

  .apex-benefits__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .apex-benefits__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .apex-benefits__icon {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .apex-benefits__title {
    margin: 8px 0 0;
    font-size: 1.125rem;
  }

  .apex-benefits__text {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.8;
  }

  .apex-benefits__link {
    margin-top: auto;
    padding-top: 12px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  @media screen and (min-width: 990px) {
    .apex-benefits__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }
  }
  .apex-benefits--center .apex-benefits__heading {
    text-align: center;
  }

  .apex-benefits--center .apex-benefits__card {
    align-items: center;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook benefits",
  "tag": "section",
  "class": "apex-section",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join ApexCook. Enjoy the benefits" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable animation", "default": true }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free UK delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "On orders over £50." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ApexCook benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Free UK delivery", "text": "On orders over £50." } },
        { "type": "benefit", "settings": { "title": "30-day returns", "text": "Changed your mind? Send it back within 30 days." } },
        { "type": "benefit", "settings": { "title": "10-year guarantee", "text": "Built to last, backed for a decade." } },
        { "type": "benefit", "settings": { "title": "Secure checkout", "text": "Apple Pay, Google Pay, Shop Pay and cards." } }
      ]
    }
  ]
}
{% endschema %}
