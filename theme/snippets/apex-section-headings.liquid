{%- doc -%}
  One size for every section title across the ApexCook sections, matched to Samsung UK:
  25px on phones, 32px on tablets, 40px on desktop; semibold (nothing heavier than 600). Page H1s (hero, collection) and banner headlines keep their own sizes.

  @example
  {% render 'apex-section-headings' %}
{%- enddoc -%}

{% stylesheet %}
  /* Keep off-screen carousel content (and its visually-hidden labels) from widening the page. */
  html,
  body {
    overflow-x: clip;
  }

  [data-track] > li,
  .apex-pcarousel__item {
    position: relative;
  }

  /* Samsung mobile header: 64px bar, 24px side margin for the logo. */
  @media screen and (max-width: 749px) {
    .header .header__row--top .header__columns.spacing-style {
      --padding-inline-start: 24px;
      min-height: 64px;
      padding-inline-start: 24px;
    }
  }

  /* One vertical rhythm for ApexCook sections: 48px top/bottom on phones, 64px from 990px. */
  :root {
    --apex-space: 48px;
  }

  @media screen and (min-width: 990px) {
    :root {
      --apex-space: 64px;
    }
  }

  body .shopify-section :is(
    .apex-benefits__heading,
    .apex-chefs__heading,
    .apex-cc__heading,
    .apex-cmp__heading,
    .apex-fh__opener-title,
    .apex-bento__heading,
    .apex-compare-slider__heading,
    .apex-compare__heading,
    .apex-cooked-with__heading,
    .apex-faq__heading,
    .apex-highlights__heading,
    .apex-pcarousel__heading,
    .apex-press__heading,
    .apex-recipes__heading,
    .apex-reviews__heading,
    .apex-specs__heading,
    .apex-story__heading,
    .apex-support__heading,
    .apex-testimonials__heading,
    .apex-uses__heading
  ) {
    font-size: 25px;
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: normal;
  }

  @media screen and (min-width: 750px) {
    body .shopify-section :is(
      .apex-benefits__heading,
    .apex-chefs__heading,
    .apex-cc__heading,
    .apex-cmp__heading,
    .apex-fh__opener-title,
      .apex-bento__heading,
      .apex-compare-slider__heading,
      .apex-compare__heading,
      .apex-cooked-with__heading,
      .apex-faq__heading,
      .apex-highlights__heading,
      .apex-pcarousel__heading,
      .apex-press__heading,
      .apex-recipes__heading,
      .apex-reviews__heading,
      .apex-specs__heading,
      .apex-story__heading,
      .apex-support__heading,
      .apex-testimonials__heading,
      .apex-uses__heading
    ) {
      font-size: 32px;
    }
  }

  @media screen and (min-width: 990px) {
    body .shopify-section :is(
      .apex-benefits__heading,
    .apex-chefs__heading,
    .apex-cc__heading,
    .apex-cmp__heading,
    .apex-fh__opener-title,
      .apex-bento__heading,
      .apex-compare-slider__heading,
      .apex-compare__heading,
      .apex-cooked-with__heading,
      .apex-faq__heading,
      .apex-highlights__heading,
      .apex-pcarousel__heading,
      .apex-press__heading,
      .apex-recipes__heading,
      .apex-reviews__heading,
      .apex-specs__heading,
      .apex-story__heading,
      .apex-support__heading,
      .apex-testimonials__heading,
      .apex-uses__heading
    ) {
      font-size: 40px;
    }
  }
{% endstylesheet %}
