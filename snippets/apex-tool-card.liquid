{%- doc -%}
  Product card for "Shop the tools you will need" on recipe pages: photo, name, stock line,
  price (genuine previous price in red) and an outlined ADD button.

  @param {object} product - Product

  @example
  {% render 'apex-tool-card', product: product %}
{%- enddoc -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign return_to = routes.cart_url
  if settings.apex_upsell_page != blank
    assign return_to = settings.apex_upsell_page.url | append: '?added=' | append: variant.id
  endif
-%}
<div class="apex-tool">
  <a class="apex-tool__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 990px) 310px, 70vw', alt: '' }}
    {%- endif -%}
  </a>
  <a class="apex-tool__title" href="{{ product.url }}">{{ product.title | escape }}</a>
  <p class="apex-tool__stock{% unless product.available %} is-out{% endunless %}">
    {%- if product.available -%}
      {{ 'ph-check-circle.svg' | inline_asset_content | replace: '<svg ', '<svg width="18" height="18" ' }}
      {{ 'apex.recipe_page.in_stock' | t }}
    {%- else -%}
      {{ 'apex.search.sold_out' | t }}
    {%- endif -%}
  </p>
  <p class="apex-tool__price">
    {%- if variant.compare_at_price > variant.price -%}
      <s><span class="visually-hidden">{{ 'apex.deal.was' | t }} </span>{{ variant.compare_at_price | money }}</s>
      <span class="apex-tool__sale">{{ variant.price | money }}</span>
    {%- else -%}
      {{ variant.price | money }}
    {%- endif -%}
  </p>
  {%- if product.has_only_default_variant -%}
    <form method="post" action="{{ routes.cart_add_url }}">
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <input type="hidden" name="return_to" value="{{ return_to }}">
      <button type="submit" class="apex-tool__btn"{% unless variant.available %} disabled{% endunless %}>{{ 'apex.recipe_page.add' | t }}</button>
    </form>
  {%- else -%}
    <a class="apex-tool__btn" href="{{ product.url }}">{{ 'apex.recipe_page.choose' | t }}</a>
  {%- endif -%}
</div>

{% stylesheet %}
  .apex-tool {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: #222222;
  }

  .apex-tool__media {
    display: block;
    aspect-ratio: 1;
    margin-bottom: 14px;
    background: #F7F7F7;
  }

  .apex-tool__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apex-tool__title {
    min-height: calc(2 * 1.5em);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
    color: inherit;
    text-decoration: none;
  }

  .apex-tool__title:hover {
    text-decoration: underline;
  }

  .apex-tool__stock {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 6px 0 18px;
    font-size: 13px;
    color: #008A05;
  }

  .apex-tool__stock.is-out {
    color: #6A6A6A;
  }

  .apex-tool__price {
    display: flex;
    gap: 6px;
    margin: auto 0 12px;
    font-size: 18px;
    font-weight: 600;
  }

  .apex-tool__price s {
    font-weight: 500;
  }

  .apex-tool__sale {
    color: #E00B41;
  }

  .apex-tool__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    border: 1px solid #222222;
    background: #fff;
    color: #222222;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .apex-tool__btn:hover {
    background: #222222;
    color: #fff;
  }

  .apex-tool__btn:disabled {
    border-color: #DDDDDD;
    color: #6A6A6A;
    cursor: not-allowed;
  }
{% endstylesheet %}
