{% comment %}
  Section contract.
  FAQ accordion with an "Expand all" control and FAQPage structured data built from the blocks.
  @example
  <!-- Add "ApexCook FAQ" and add question blocks -->
{% endcomment %}
{% render 'apex-accordion-styles' %}
<div class="apex-faq section section--page-width">
  <apex-expand-all>
    <div class="apex-accordion__header">
      <h2 class="apex-faq__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.blocks.size > 1 -%}
        <button
          type="button"
          class="apex-accordion__expand"
          data-expand-all
          data-label-expand="{{ 'apex.faq.expand_all' | t }}"
          data-label-collapse="{{ 'apex.faq.collapse_all' | t }}"
          aria-expanded="false"
        >
          {{- 'apex.faq.expand_all' | t -}}
        </button>
      {%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      <details class="apex-accordion__item" {{ block.shopify_attributes }}>
        <summary class="apex-accordion__summary">{{ block.settings.question | escape }}</summary>
        <div class="apex-accordion__body rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </apex-expand-all>
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .apex-faq {
    padding-block: 48px;
  }

  .apex-faq__heading {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook FAQ",
  "tag": "section",
  "class": "apex-section",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" }],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Is the pan safe on induction hobs?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add your answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ApexCook FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
