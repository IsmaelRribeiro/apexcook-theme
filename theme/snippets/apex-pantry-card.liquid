{%- doc -%}
  Article card for the Pantry page. Default: horizontal card (square image left, grey text panel
  right). `featured`: large image left (50%) with title, excerpt and a "Read more" button right.

  @param {object} article - Article to show
  @param {boolean} [featured] - Large featured layout

  @example
  {% render 'apex-pantry-card', article: article, featured: true %}
{%- enddoc -%}

{%- liquid
  assign excerpt = article.excerpt | default: article.content | strip_html | strip_newlines | truncatewords: 40
  assign prep = article.metafields.recipe.prep_minutes.value
  assign difficulty = article.metafields.recipe.difficulty.value
-%}

{%- if featured -%}
  <article class="apex-pcard apex-pcard--featured">
    <a class="apex-pcard__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
      {%- if article.image -%}
        {{ article.image | image_url: width: 1300 | image_tag: loading: 'lazy', widths: '650, 1000, 1300', sizes: '(min-width: 990px) 650px, 100vw', alt: '' }}
      {%- endif -%}
    </a>
    <div class="apex-pcard__body">
      <h3 class="apex-pcard__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
      {%- if prep or difficulty -%}
        <p class="apex-pcard__meta">
          {%- if prep -%}{{ 'apex.recipe.prep_time' | t: minutes: prep }}{%- endif -%}
          {%- if prep and difficulty %} · {% endif -%}
          {%- if difficulty -%}{{ difficulty | escape }}{%- endif -%}
        </p>
      {%- endif -%}
      {%- if excerpt != blank -%}<p class="apex-pcard__text">{{ excerpt }}</p>{%- endif -%}
      <a class="apex-pantry__button" href="{{ article.url }}">
        {{- 'apex.pantry.read_more' | t -}}<span class="visually-hidden">: {{ article.title | escape }}</span>
      </a>
    </div>
  </article>
{%- else -%}
  <article class="apex-pcard">
    <a class="apex-pcard__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
      {%- if article.image -%}
        {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 990px) 294px, 45vw', alt: '' }}
      {%- endif -%}
    </a>
    <div class="apex-pcard__body">
      <h3 class="apex-pcard__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
      {%- if excerpt != blank -%}<p class="apex-pcard__text">{{ excerpt }}</p>{%- endif -%}
      <a class="apex-pcard__link" href="{{ article.url }}">
        {{- 'apex.pantry.read_more_short' | t -}}
        <span class="visually-hidden">: {{ article.title | escape }}</span>
        {%- render 'apex-mnav-icon', icon: 'right' -%}
      </a>
    </div>
  </article>
{%- endif -%}

{% stylesheet %}
  .apex-pcard {
    display: grid;
    grid-template-columns: minmax(0, 46%) minmax(0, 1fr);
    height: 100%;
    background: #f5f5f5;
    color: #282829;
  }

  .apex-pcard__media {
    display: block;
    aspect-ratio: 1;
    background: #e9e9e9;
  }

  .apex-pcard__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apex-pcard__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
  }

  .apex-pcard__title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }

  @media screen and (min-width: 990px) {
    .apex-pcard__title {
      font-size: 22px;
    }
  }

  .apex-pcard__title a {
    color: inherit;
    text-decoration: none;
  }

  .apex-pcard__title a:hover {
    text-decoration: underline;
  }

  .apex-pcard__meta {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    color: #6b6b6b;
  }

  .apex-pcard__text {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 15px;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  @media screen and (min-width: 990px) {
    .apex-pcard__text {
      font-size: 16px;
    }
  }

  .apex-pcard__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    font-size: 13px;
    font-weight: 500;
    color: #282829;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .apex-pcard__link .apex-mnav__svg {
    width: 14px;
    height: 14px;
  }

  @media screen and (max-width: 589px) {
    .apex-pcard {
      grid-template-columns: 1fr;
    }

    .apex-pcard__media {
      aspect-ratio: 16 / 10;
    }
  }

  /* Featured */
  .apex-pcard--featured {
    grid-template-columns: 1fr;
    gap: 0;
    background: #fff;
  }

  @media screen and (min-width: 750px) {
    .apex-pcard--featured {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
      gap: 30px;
    }
  }

  .apex-pcard--featured .apex-pcard__media {
    aspect-ratio: 635 / 400;
  }

  .apex-pcard--featured .apex-pcard__body {
    align-items: flex-start;
    gap: 12px;
    padding: 20px 0 0;
  }

  @media screen and (min-width: 750px) {
    .apex-pcard--featured .apex-pcard__body {
      padding: 0;
    }
  }

  .apex-pcard--featured .apex-pcard__title {
    font-size: 22px;
  }

  @media screen and (min-width: 990px) {
    .apex-pcard--featured .apex-pcard__title {
      font-size: 24px;
    }
  }

  .apex-pcard--featured .apex-pcard__text {
    -webkit-line-clamp: 4;
  }

  .apex-pcard--featured .apex-pantry__button {
    margin-top: 6px;
  }

  .apex-pantry__row--tinted .apex-pcard--featured {
    background: transparent;
  }

  .apex-pantry__row--tinted .apex-pcard:not(.apex-pcard--featured) {
    background: #fff;
  }
{% endstylesheet %}
