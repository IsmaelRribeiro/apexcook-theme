{%- doc -%}
  Navigation icons from Phosphor Icons (regular weight, MIT licence – phosphoricons.com).

  @param {string} icon - 'menu', 'close', 'search', 'right', 'left' or 'down'

  @example
  {% render 'apex-mnav-icon', icon: 'close' %}
{%- enddoc -%}
{%- liquid
  case icon
    when 'menu'
      assign file = 'ph-list.svg'
    when 'close'
      assign file = 'ph-x.svg'
    when 'search'
      assign file = 'ph-magnifying-glass.svg'
    when 'right'
      assign file = 'ph-caret-right.svg'
    when 'left'
      assign file = 'ph-caret-left.svg'
    else
      assign file = 'ph-caret-down.svg'
  endcase
  assign cls = '<svg class="apex-mnav__svg apex-mnav__svg--' | append: icon | append: '" width="24" height="24" '
-%}
{{- file | inline_asset_content | replace: '<svg ', cls -}}
