{% comment %}
  Section contract.
  "Black Shop" mosaic: a heading plus one large tile and up to four small linked image tiles.
  Desktop: large tile spans two rows beside a 2×2 grid. Mobile: large tile on top, 2×2 below.
  @example
  <!-- Add "ApexCook mosaic" and add up to 5 tiles; the first tile is the large one -->
{% endcomment %}
{%- if section.settings.enable_animation -%}{% render 'apex-motion-styles' %}{%- endif -%}
<div class="apex-bento section section--page-width">
  <div>
    {%- if section.settings.heading != blank -%}
      <h2 class="apex-bento__heading" {% if section.settings.enable_animation %}data-apex-reveal{% endif %}>
        {{- section.settings.heading | escape -}}
      </h2>
    {%- endif -%}
    <div class="apex-bento__grid">
      {%- for block in section.blocks limit: 5 -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
          if forloop.first
            assign sizes = '(min-width: 750px) 50vw, 100vw'
          else
            assign sizes = '(min-width: 750px) 25vw, 50vw'
          endif
        -%}
        <{{ tag }}
          class="apex-bento__tile{% if forloop.first %} apex-bento__tile--large{% endif %}"
          {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400, 700, 1000, 1400',
                sizes: sizes,
                alt: block.settings.label,
                class: 'apex-bento__image'
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'apex-bento__image' }}
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <span class="visually-hidden">{{ block.settings.label | escape }}</span>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .apex-bento {
    padding-block: 48px;
  }

  .apex-bento__heading {
    margin: 0 0 32px;
    text-align: center;
  }

  .apex-bento__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .apex-bento__tile {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    min-width: 0;
  }

  .apex-bento__tile--large {
    grid-column: 1 / -1;
  }

  .apex-bento__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  a.apex-bento__tile:hover .apex-bento__image {
    transform: scale(1.03);
  }

  @media screen and (min-width: 750px) {
    .apex-bento__grid {
      grid-template-columns: 2fr 1fr 1fr;
      grid-auto-rows: 1fr;
      gap: 16px;
    }

    .apex-bento__tile--large {
      grid-column: 1;
      grid-row: span 2;
      aspect-ratio: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-bento__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook mosaic",
  "tag": "section",
  "class": "apex-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Shop: ApexCook deals in one place" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable animation", "default": true }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Accessible label", "info": "Describes the image and link for screen readers." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ApexCook mosaic",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
