{% comment %}
  Section contract.
  "Highlights": up to four icon cards with a title and one line of text (Samsung-style), shown
  right after the buy area.
  @example
  <!-- Product template, after the main product section -->
{% endcomment %}
{%- if section.settings.enable_animation -%}{% render 'apex-motion-styles' %}{%- endif -%}
<div class="apex-highlights section section--page-width">
  <div>
    <h2 class="apex-highlights__heading">{{ section.settings.heading | escape }}</h2>
    <ul class="apex-highlights__list" role="list">
      {%- for block in section.blocks -%}
        <li class="apex-highlights__card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            {{ block.settings.icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', class: 'apex-highlights__icon' }}
          {%- endif -%}
          <p class="apex-highlights__title">{{ block.settings.title | escape }}</p>
          {%- if block.settings.text != blank -%}<p class="apex-highlights__text">{{ block.settings.text | escape }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .apex-highlights {
    padding-block: 48px;
  }

  .apex-highlights__heading {
    margin: 0 0 24px;
  }

  .apex-highlights__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .apex-highlights__card {
    padding: 24px;
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .apex-highlights__icon {
    width: 40px;
    height: 40px;
    margin-bottom: 16px;
    object-fit: contain;
  }

  .apex-highlights__title {
    margin: 0 0 4px;
    font-weight: 600;
  }

  .apex-highlights__text {
    margin: 0;
    font-size: 0.8125rem;
    opacity: 0.8;
  }

  @media screen and (min-width: 990px) {
    .apex-highlights__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook highlights",
  "tag": "section",
  "class": "apex-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Highlights" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable animation", "default": true }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Pure titanium" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "ApexCook highlights", "blocks": [{ "type": "highlight" }, { "type": "highlight" }, { "type": "highlight" }, { "type": "highlight" }] }]
}
{% endschema %}
