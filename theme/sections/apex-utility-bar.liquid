{%- comment -%}
  Thin utility row above the main header (Samsung-style "Support · For Business").
  Desktop only; links come from Theme settings → ApexCook → Utility links menu.
{%- endcomment -%}

{%- assign utility_menu = settings.apex_utility_menu -%}
{%- if utility_menu.links.size > 0 -%}
  <div class="apex-utility-bar">
    <ul class="apex-utility-bar__list list-unstyled">
      {%- for link in utility_menu.links -%}
        <li>
          <a class="apex-utility-bar__link" href="{{ link.url }}">{{ link.title | escape }}</a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .apex-utility-bar {
    display: none;
    background: var(--color-background, #fff);
  }

  @media screen and (min-width: 990px) {
    .apex-utility-bar {
      display: block;
      padding: 6px 24px 0;
    }
  }

  .apex-utility-bar__list {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin: 0;
  }

  .apex-utility-bar__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.33;
    color: var(--color-foreground, #222222);
    text-decoration: none;
  }

  .apex-utility-bar__link:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Utility links",
  "tag": "div",
  "class": "apex-utility-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Links come from Theme settings → ApexCook → Utility links menu."
    }
  ],
  "presets": [
    {
      "name": "Utility links"
    }
  ]
}
{% endschema %}
