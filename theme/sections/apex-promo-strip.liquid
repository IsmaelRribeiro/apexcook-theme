{% comment %}
  Section contract.
  Thin promotional strip (Samsung-style) above the product header, with optional link.
  @example
  <!-- Product template, first section -->
{% endcomment %}
{%- if section.settings.text != blank -%}
  <div class="apex-promo-strip" style="--apex-bg: {{ section.settings.background_color }}; --apex-fg: {{ section.settings.text_color }};">
    <div class="section section--page-width">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
      {%- else -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .apex-promo-strip {
    background: var(--apex-bg);
    color: var(--apex-fg);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .apex-promo-strip p,
  .apex-promo-strip a {
    margin: 0;
    padding-block: 10px;
    color: inherit;
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook promo strip",
  "tag": "section",
  "class": "apex-section",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery on orders over £50" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "ApexCook promo strip" }]
}
{% endschema %}
