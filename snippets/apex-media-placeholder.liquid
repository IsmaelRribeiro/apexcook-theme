{% doc %}
  Grey placeholder gallery (one large box and a row of thumbnail boxes) shown when a product has
  no images yet, so the Samsung-style layout keeps its shape.

  @example
  {% render 'apex-media-placeholder' %}
{% enddoc %}
<div class="apex-media-placeholder" aria-hidden="true">
  <div class="apex-media-placeholder__main"></div>
  <div class="apex-media-placeholder__thumbs">
    {%- for i in (1..5) -%}<span></span>{%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .apex-media-placeholder {
    display: grid;
    gap: 12px;
  }

  .apex-media-placeholder__main {
    aspect-ratio: 1;
    background: #e6e6e6;
  }

  .apex-media-placeholder__thumbs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }

  .apex-media-placeholder__thumbs span {
    aspect-ratio: 1;
    background: #ededed;
  }
{% endstylesheet %}
