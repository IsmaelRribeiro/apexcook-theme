{% comment %}
  Section contract.
  "Highlights": up to four icon cards with a title and one line of text (Samsung-style), shown
  right after the buy area.
  @example
  <!-- Product template, after the main product section -->
{% endcomment %}
{%- if section.settings.enable_animation -%}{% render 'apex-motion-styles' %}{%- endif -%}
<div class="apex-highlights section section--page-width">
  <div>
    <h2 class="apex-highlights__heading">{{ section.settings.heading | escape }}</h2>
    <ul class="apex-highlights__list" role="list">
      {%- for block in section.blocks -%}
        <li class="apex-highlights__card" {{ block.shopify_attributes }}>
          <span class="apex-benefits__icon-tile">
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', class: 'apex-benefits__icon' }}
            {%- else -%}
              {% render 'apex-benefit-icon', icon: block.settings.icon_name %}
            {%- endif -%}
          </span>
          <p class="apex-highlights__title">{{ block.settings.title | escape }}</p>
          {%- if block.settings.text != blank -%}<p class="apex-highlights__text">{{ block.settings.text | escape }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  /* Same card as "ApexCook benefits" (white, hairline border, blue outline icon tile); icon tile styles live there. */
  .apex-highlights {
    padding-block: var(--apex-space);
  }

  .apex-highlights__heading {
    margin: 0 0 32px;
  }

  .apex-highlights__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .apex-highlights__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .apex-highlights__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
  }

  .apex-highlights__card {
    padding: 16px 16px 20px;
    border: 1px solid #ddd;
    background: #fff;
    color: #000;
  }

  .apex-highlights__title {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.33;
  }

  @media screen and (min-width: 750px) {
    .apex-highlights__card {
      padding: 28px 28px 32px;
    }

    .apex-highlights__title {
      margin-bottom: 10px;
      font-size: 20px;
    }

    .apex-highlights__text {
      font-size: 16px;
    }
  }

  @media screen and (min-width: 990px) {
    .apex-highlights__title {
      font-size: 22px;
    }
  }

  .apex-highlights__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.33;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook highlights",
  "tag": "section",
  "class": "apex-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Highlights" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable animation", "default": true }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon_name",
          "label": "Icon",
          "options": [
            { "value": "pan", "label": "Pan" },
            { "value": "leaf", "label": "Leaf / healthy" },
            { "value": "flame", "label": "Hob / flame" },
            { "value": "guarantee", "label": "Guarantee" },
            { "value": "dishwasher", "label": "Dishwasher" },
            { "value": "delivery", "label": "Delivery" },
            { "value": "returns", "label": "Returns" },
            { "value": "secure", "label": "Secure" },
            { "value": "support", "label": "Support" },
            { "value": "recipes", "label": "Recipes" },
            { "value": "rewards", "label": "Sparkle" }
          ],
          "default": "pan"
        },
        { "type": "image_picker", "id": "icon", "label": "Custom icon", "info": "Overrides the icon above." },
        { "type": "text", "id": "title", "label": "Title", "default": "Pure titanium" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "ApexCook highlights", "blocks": [{ "type": "highlight" }, { "type": "highlight" }, { "type": "highlight" }, { "type": "highlight" }] }]
}
{% endschema %}
