{% comment %}
  Section contract.
  "Toxic vs Safe" before/after slider. Wraps Horizon's comparison-slider block (drag, touch and
  keyboard support) with a heading and per-side labels.
  @example
  <!-- Product template; set before/after images and texts in the slider block -->
{% endcomment %}
<div class="apex-compare-slider section section--page-width">
  <div>
    {%- if section.settings.heading != blank -%}<h2 class="apex-compare-slider__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="apex-compare-slider__labels" aria-hidden="true">
      <span><strong>{{ section.settings.left_label | escape }}</strong> {{ section.settings.left_caption | escape }}</span>
      <span><strong>{{ section.settings.right_label | escape }}</strong> {{ section.settings.right_caption | escape }}</span>
    </div>
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .apex-compare-slider {
    padding-block: 48px;
  }

  .apex-compare-slider__heading {
    margin: 0 0 16px;
    text-align: center;
  }

  .apex-compare-slider__labels {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
    font-size: 0.875rem;
  }

  .apex-compare-slider__labels strong {
    display: block;
    font-size: 1.25rem;
  }

  .apex-compare-slider__labels span:last-child {
    text-align: end;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ApexCook toxic vs safe",
  "tag": "section",
  "class": "apex-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "left_label", "label": "Left label", "default": "Toxic" },
    { "type": "text", "id": "left_caption", "label": "Left caption", "default": "Non-stick coating" },
    { "type": "text", "id": "right_label", "label": "Right label", "default": "Safe" },
    { "type": "text", "id": "right_caption", "label": "Right caption", "default": "Pure titanium" }
  ],
  "blocks": [{ "type": "comparison-slider" }],
  "max_blocks": 1,
  "presets": [{ "name": "ApexCook toxic vs safe", "blocks": [{ "type": "comparison-slider" }] }]
}
{% endschema %}
