{%- doc -%}
  One size for every section title across the ApexCook sections, matched to Samsung UK:
  25px on phones, 32px on tablets, 40px on desktop; semibold (nothing heavier than 600). Page H1s (hero, collection) and banner headlines keep their own sizes.

  @example
  {% render 'apex-section-headings' %}
{%- enddoc -%}

{% stylesheet %}
  /* 8px corners on ApexCook cards, buttons, fields, chips and the images inside them. Full-width
     bands, bars, progress tracks and round icon buttons keep their own shape. */
  .apex-benefits__card,
  .apex-benefits__icon-tile,
  .apex-highlights__card,
  .apex-chefs__card,
  .apex-chefs__img,
  .apex-testimonials__frame,
  .apex-deal,
  .apex-deal__pair,
  .apex-deal__btn,
  .apex-deal__pair-media,
  .apex-pcarousel__media,
  .apex-card-cta__button,
  .apex-cc__img img,
  .apex-cc__ph,
  .apex-cc__more,
  .apex-cmp__stage,
  .apex-buy-box,
  .apex-buy-box__submit,
  .apex-buy-box__clear,
  .apex-addons__more,
  .apex-anchor-nav__cta,
  .apex-precheck__card,
  .apex-precheck__link,
  .apex-size-guide__panel,
  .apex-size-guide__link,
  .apex-tool__btn,
  .apex-tool__media,
  .apex-rpage__fact,
  .apex-rpage__share-btn,
  .apex-rpage__other,
  .apex-rpage__other-media,
  .apex-rpage__photo,
  .apex-pcard,
  .apex-pcard__media,
  .apex-pantry__button,
  .apex-pantry__arrow,
  .apex-pantry__tab,
  .apex-pantry__search input[type='search'],
  .apex-pantry__search button,
  .apex-recipes__tags a,
  .apex-support__links a,
  .apex-sr__card,
  .apex-sr__image,
  .apex-sr__chip,
  .apex-sr__cta,
  .apex-sr__more,
  .apex-sr__filters-btn,
  .apex-sr__confirm,
  .apex-sr__option,
  .apex-sr__search input[type='search'],
  .apex-sr__sort select,
  .apex-search__thumb-image,
  .apex-plp__cat-link,
  .apex-plp__promo,
  .apex-up__continue,
  .apex-empty-cta__button,
  .apex-media-banner__button,
  .apex-split-hero__button,
  .apex-mobile-checkout__button,
  .apex-mnav__search-input,
  .apex-trust__item,
  .apex-free-delivery__track,
  .apex-free-delivery__fill,
  .apex-accordion__expand {
    border-radius: 8px;
  }

  .apex-chefs__img,
  .apex-tool__media img,
  .apex-pcard__media img,
  .apex-rpage__other-media img,
  .apex-rpage__photo img,
  .apex-pcarousel__media img,
  .apex-testimonials__media {
    border-radius: inherit;
  }

  .apex-testimonials__frame,
  .apex-tool__media,
  .apex-pcard__media,
  .apex-rpage__other,
  .apex-rpage__photo,
  .apex-cmp__stage {
    overflow: hidden;
  }

  /* Buttons, chips, steppers, tabs and search fields are fully rounded (pills). !important so the
     pill wins over component rules that set an 8px corner with a more specific selector. */
  .apex-deal__btn,
  .apex-card-cta__button,
  .apex-cc__more,
  .apex-buy-box__submit,
  .apex-buy-box__clear,
  .apex-addons__btn,
  .apex-addons__more,
  .apex-anchor-nav__cta,
  .apex-tool__btn,
  .apex-rpage__share-btn,
  .apex-pantry__button,
  .apex-pantry__arrow,
  .apex-pantry__tab,
  .apex-pantry__search input[type='search'],
  .apex-pantry__search button,
  .apex-recipes__tags a,
  .apex-support__links a,
  .apex-sr__chip,
  .apex-sr__cta,
  .apex-sr__more,
  .apex-sr__filters-btn,
  .apex-sr__confirm,
  .apex-sr__search input[type='search'],
  .apex-up__continue,
  .apex-empty-cta__button,
  .apex-media-banner__button,
  .apex-split-hero__button,
  .apex-mobile-checkout__button,
  .apex-cart__btn,
  .apex-cart__qty,
  .apex-pcarousel__arrow,
  .apex-plp__pill,
  .apex-mnav__search-input,
  .apex-accordion__expand {
    border-radius: 999px !important;
  }

  /* Airbnb palette (airbnb.co.uk): Hof #222222 text, Foggy #6A6A6A secondary, Deco #DDDDDD and
     Bebe #EBEBEB lines, Faint #F7F7F7 surfaces, Rausch #FF385C accent. Primary buttons use the Rausch
     gradient (#E61E4D → #E31C5F → #D70466) and its radial hover. */
  :root {
    --apex-rausch: #ff385c;
    --apex-rausch-gradient: linear-gradient(to right, #e61e4d 0%, #e31c5f 50%, #d70466 100%);
    --apex-rausch-gradient-hover: radial-gradient(circle at center, #ff385c 0%, #e61e4d 27.5%, #e31c5f 40%, #d70466 57.5%, #bd1e59 75%, #bd1e59 100%);
  }

  .apex-buy-box__submit,
  .apex-anchor-nav__cta,
  .apex-cart__btn--primary,
  .apex-deal__btn--primary,
  .apex-sr__cta--buy,
  .apex-card-cta__button,
  .apex-mobile-checkout__button,
  .apex-empty-cta__button,
  .apex-media-banner__button,
  .button:not(.button-secondary, .button-unstyled, .slideshow-control, .button--tertiary) {
    border-color: transparent !important;
    background: var(--apex-rausch-gradient) !important;
    color: #fff !important;
  }

  .apex-buy-box__submit:hover:not(:disabled),
  .apex-anchor-nav__cta:hover,
  .apex-cart__btn--primary:hover,
  .apex-deal__btn--primary:hover,
  .apex-sr__cta--buy:hover,
  .apex-card-cta__button:hover,
  .apex-mobile-checkout__button:hover,
  .apex-empty-cta__button:hover,
  .apex-media-banner__button:hover,
  .button:not(.button-secondary, .button-unstyled, .slideshow-control, .button--tertiary):hover {
    background: var(--apex-rausch-gradient-hover) !important;
    color: #fff !important;
  }

  .apex-buy-box__submit:disabled,
  .apex-sr__cta--buy:disabled,
  .apex-deal__btn--primary:disabled {
    background: #dddddd !important;
    color: #6a6a6a !important;
  }

  /* Keep off-screen carousel content (and its visually-hidden labels) from widening the page. */
  html,
  body {
    overflow-x: clip;
  }

  [data-track] > li,
  .apex-pcarousel__item {
    position: relative;
  }

  /* One vertical rhythm for ApexCook sections: 48px top/bottom on phones, 64px from 990px. */
  :root {
    --apex-space: 48px;
  }

  @media screen and (min-width: 990px) {
    :root {
      --apex-space: 64px;
    }
  }

  body .shopify-section :is(
    .apex-benefits__heading,
    .apex-chefs__heading,
    .apex-cc__heading,
    .apex-cmp__heading,
    .apex-fh__opener-title,
    .apex-bento__heading,
    .apex-compare-slider__heading,
    .apex-compare__heading,
    .apex-cooked-with__heading,
    .apex-faq__heading,
    .apex-highlights__heading,
    .apex-pcarousel__heading,
    .apex-press__heading,
    .apex-recipes__heading,
    .apex-reviews__heading,
    .apex-specs__heading,
    .apex-story__heading,
    .apex-support__heading,
    .apex-testimonials__heading,
    .apex-uses__heading
  ) {
    font-size: 25px;
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: normal;
  }

  @media screen and (min-width: 750px) {
    body .shopify-section :is(
      .apex-benefits__heading,
    .apex-chefs__heading,
    .apex-cc__heading,
    .apex-cmp__heading,
    .apex-fh__opener-title,
      .apex-bento__heading,
      .apex-compare-slider__heading,
      .apex-compare__heading,
      .apex-cooked-with__heading,
      .apex-faq__heading,
      .apex-highlights__heading,
      .apex-pcarousel__heading,
      .apex-press__heading,
      .apex-recipes__heading,
      .apex-reviews__heading,
      .apex-specs__heading,
      .apex-story__heading,
      .apex-support__heading,
      .apex-testimonials__heading,
      .apex-uses__heading
    ) {
      font-size: 32px;
    }
  }

  @media screen and (min-width: 990px) {
    body .shopify-section :is(
      .apex-benefits__heading,
    .apex-chefs__heading,
    .apex-cc__heading,
    .apex-cmp__heading,
    .apex-fh__opener-title,
      .apex-bento__heading,
      .apex-compare-slider__heading,
      .apex-compare__heading,
      .apex-cooked-with__heading,
      .apex-faq__heading,
      .apex-highlights__heading,
      .apex-pcarousel__heading,
      .apex-press__heading,
      .apex-recipes__heading,
      .apex-reviews__heading,
      .apex-specs__heading,
      .apex-story__heading,
      .apex-support__heading,
      .apex-testimonials__heading,
      .apex-uses__heading
    ) {
      font-size: 40px;
    }
  }
{% endstylesheet %}
