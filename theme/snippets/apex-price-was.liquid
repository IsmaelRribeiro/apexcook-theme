{% doc %}
  Price with an optional struck-through previous price (labelled "Was"/"RRP" for screen readers,
  from the product's apex.was_label metafield) and "Save £X" beside it. The previous price only shows when compare_at_price is above price.

  @param {object} product - Product (for the label metafield)
  @param {object} variant - Variant whose prices are shown
  @param {boolean} [compact] - Smaller single-line variant for cards

  @example
  {% render 'apex-price-was', product: product, variant: product.selected_or_first_available_variant %}
{% enddoc %}
{%- liquid
  assign label = product.metafields.apex.was_label.value | default: 'Was'
  if label == 'RRP'
    assign label_text = 'apex.buy_box.rrp' | t
  else
    assign label_text = 'apex.buy_box.was' | t
  endif
  assign has_was = false
  if variant.compare_at_price > variant.price
    assign has_was = true
    assign saving = variant.compare_at_price | minus: variant.price | money
  endif
-%}
<div class="apex-price{% if compact %} apex-price--compact{% endif %}" data-apex-price>
  <span class="apex-price__now">{{ variant.price | money }}</span>
  {%- if has_was -%}
    <span class="apex-price__deal">
      <span class="apex-price__was">
        <span class="visually-hidden">{{ label_text }}</span>
        <s>{{ variant.compare_at_price | money }}</s>
      </span>
      <span class="apex-price__save">{{ 'apex.buy_box.save' | t: amount: saving }}</span>
    </span>
  {%- endif -%}
</div>

{% stylesheet %}
  .apex-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }

  .apex-price__now {
    font-size: 1.75rem;
    font-weight: 600;
  }

  /* Previous price and saving sit side by side on one line. */
  .apex-price__deal {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
  }

  .apex-price__was {
    display: inline-flex;
    gap: 4px;
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .apex-price__save {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary-button-background);
  }

  .apex-price--compact .apex-price__now {
    font-size: 1rem;
  }
{% endstylesheet %}
